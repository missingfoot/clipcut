#!/usr/bin/env python3
"""ClipCut: quick drag-and-drop trim/crop tool that preserves source mtime."""

import json
import os
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import Qt, QProcess
from PySide6.QtGui import QFontDatabase
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QFormLayout,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QMainWindow,
    QPlainTextEdit,
    QPushButton,
    QVBoxLayout,
    QWidget,
)


def probe(path):
    out = subprocess.run(
        [
            "ffprobe", "-v", "error",
            "-select_streams", "v:0",
            "-show_entries", "stream=width,height",
            "-show_entries", "format=duration",
            "-of", "json",
            str(path),
        ],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip() or "ffprobe failed")
    data = json.loads(out.stdout)
    stream = data["streams"][0]
    duration = float(data["format"]["duration"])
    return int(stream["width"]), int(stream["height"]), duration


def parse_time(text):
    text = text.strip()
    if not text:
        return None
    if ":" in text:
        parts = [float(p) for p in text.split(":")]
        while len(parts) < 3:
            parts.insert(0, 0.0)
        h, m, s = parts
        return h * 3600 + m * 60 + s
    return float(text)


def next_available(path):
    if not path.exists():
        return path
    n = 2
    while True:
        candidate = path.with_name(f"{path.stem}{n}{path.suffix}")
        if not candidate.exists():
            return candidate
        n += 1


class DropLabel(QLabel):
    def __init__(self, on_drop):
        super().__init__("Drop video here")
        self.on_drop = on_drop
        self.setAlignment(Qt.AlignCenter)
        self.setAcceptDrops(True)
        self.setMinimumHeight(80)
        self.setStyleSheet(
            "QLabel { border: 2px dashed palette(mid); border-radius: 6px; padding: 8px; }"
        )

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = event.mimeData().urls()
        if urls:
            self.on_drop(Path(urls[0].toLocalFile()))


class MainWindow(QMainWindow):
    def __init__(self, initial_path=None):
        super().__init__()
        self.setWindowTitle("ClipCut")
        self.resize(420, 320)

        self.path = None
        self.width = None
        self.height = None
        self.duration = None

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)

        self.drop = DropLabel(self.load_file)
        layout.addWidget(self.drop)

        form = QFormLayout()
        self.start_edit = QLineEdit()
        self.start_edit.setPlaceholderText("0")
        self.end_edit = QLineEdit()
        self.end_edit.setPlaceholderText("0")
        form.addRow("Chop off start (secs):", self.start_edit)
        form.addRow("Chop off end (secs):", self.end_edit)
        layout.addLayout(form)

        crop_grid = QGridLayout()
        self.crop_left = QLineEdit("0")
        self.crop_top = QLineEdit("0")
        self.crop_right = QLineEdit("0")
        self.crop_bottom = QLineEdit("0")
        crop_grid.addWidget(QLabel("Crop left:"), 0, 0)
        crop_grid.addWidget(self.crop_left, 0, 1)
        crop_grid.addWidget(QLabel("top:"), 0, 2)
        crop_grid.addWidget(self.crop_top, 0, 3)
        crop_grid.addWidget(QLabel("Crop right:"), 1, 0)
        crop_grid.addWidget(self.crop_right, 1, 1)
        crop_grid.addWidget(QLabel("bottom:"), 1, 2)
        crop_grid.addWidget(self.crop_bottom, 1, 3)
        layout.addLayout(crop_grid)

        self.remove_audio = QCheckBox("Remove audio")
        layout.addWidget(self.remove_audio)

        suffix_form = QFormLayout()
        self.suffix_edit = QLineEdit()
        self.suffix_edit.setPlaceholderText("cut")
        suffix_form.addRow("Append text:", self.suffix_edit)
        layout.addLayout(suffix_form)

        self.show_command = QCheckBox("Show command")
        layout.addWidget(self.show_command)

        self.console = QPlainTextEdit()
        self.console.setReadOnly(True)
        self.console.setFont(QFontDatabase.systemFont(QFontDatabase.FixedFont))
        self.console.setMaximumBlockCount(2000)
        self.console.setVisible(False)
        layout.addWidget(self.console)

        button_row = QHBoxLayout()
        self.cut_button = QPushButton("Cut")
        self.cut_button.clicked.connect(self.do_cut)
        self.cut_button.setEnabled(False)
        button_row.addWidget(self.cut_button)

        self.done_button = QPushButton("Done")
        self.done_button.clicked.connect(self.close)
        button_row.addWidget(self.done_button)
        layout.addLayout(button_row)

        self.status = QLabel("")
        self.status.setWordWrap(True)
        layout.addWidget(self.status)

        self.setAcceptDrops(True)
        self.process = None

        self.show_command.toggled.connect(self.on_show_command_toggled)
        for field in (self.start_edit, self.end_edit, self.crop_left,
                      self.crop_top, self.crop_right, self.crop_bottom, self.suffix_edit):
            field.textChanged.connect(self.update_preview)
        self.remove_audio.toggled.connect(self.update_preview)

        if initial_path:
            self.load_file(initial_path)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = event.mimeData().urls()
        if urls:
            self.load_file(Path(urls[0].toLocalFile()))

    def load_file(self, path):
        try:
            w, h, duration = probe(path)
        except Exception as e:
            self.status.setText(f"Failed to read file: {e}")
            return
        self.path = path
        self.width, self.height = w, h
        self.duration = duration
        self.drop.setText(f"{path.name}\n{w}x{h}, {duration:.1f}s")
        self.start_edit.clear()
        self.end_edit.clear()
        self.cut_button.setEnabled(True)
        self.status.setText("")
        self.update_preview()

    def build_command(self):
        """Return (cmd, out_path). Raises ValueError on bad input."""
        chop_start = parse_time(self.start_edit.text()) or 0.0
        chop_end = parse_time(self.end_edit.text()) or 0.0
        if chop_start < 0 or chop_end < 0:
            raise ValueError("chop amounts must be >= 0")
        start = chop_start
        end = self.duration - chop_end
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("chop amounts leave nothing to cut")

        left = int(self.crop_left.text() or 0)
        top = int(self.crop_top.text() or 0)
        right = int(self.crop_right.text() or 0)
        bottom = int(self.crop_bottom.text() or 0)
        for name, v in (("left", left), ("top", top), ("right", right), ("bottom", bottom)):
            if v < 0:
                raise ValueError(f"crop {name} must be >= 0")

        crop_w = self.width - left - right
        crop_h = self.height - top - bottom
        has_crop = left or top or right or bottom
        if has_crop and (crop_w <= 0 or crop_h <= 0):
            raise ValueError("crop margins exceed frame size")

        append_text = self.suffix_edit.text().strip() or "cut"
        out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}{self.path.suffix}"))
        no_audio = self.remove_audio.isChecked()

        cmd = ["ffmpeg", "-y", "-i", str(self.path), "-ss", str(start), "-to", str(end)]
        if has_crop:
            cmd += ["-vf", f"crop={crop_w}:{crop_h}:{left}:{top}",
                    "-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        else:
            cmd += ["-c:v", "copy"]
        cmd += ["-an"] if no_audio else ["-c:a", "copy"]
        cmd.append(str(out_path))
        return cmd, out_path

    def on_show_command_toggled(self, checked):
        self.console.setVisible(checked)
        if checked:
            self.update_preview()

    def update_preview(self):
        if not self.show_command.isChecked() or self.process is not None:
            return
        if not self.path:
            self.console.setPlainText("(drop a video to see the command)")
            return
        try:
            cmd, _ = self.build_command()
            self.console.setPlainText(" ".join(cmd))
        except ValueError as e:
            self.console.setPlainText(f"(invalid input: {e})")

    def do_cut(self):
        try:
            cmd, out_path = self.build_command()
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            return

        self.pending_out_path = out_path
        self.status.setText("Cutting...")
        self.cut_button.setEnabled(False)

        if self.show_command.isChecked():
            self.console.setPlainText(" ".join(cmd) + "\n\n")

        self.process = QProcess(self)
        self.process.setProcessChannelMode(QProcess.MergedChannels)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_process_finished)
        self.process.start(cmd[0], cmd[1:])

    def on_process_output(self):
        if self.show_command.isChecked():
            data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
            self.console.appendPlainText(data.rstrip("\n"))
        else:
            self.process.readAllStandardOutput()

    def on_process_finished(self, exit_code, _exit_status):
        self.cut_button.setEnabled(True)
        out_path = self.pending_out_path
        self.process = None

        if exit_code != 0:
            self.status.setText(f"ffmpeg failed (exit {exit_code}) - see command output")
            return

        src_stat = self.path.stat()
        os.utime(out_path, (src_stat.st_atime, src_stat.st_mtime))
        self.status.setText(f"Saved: {out_path.name}")


def main():
    app = QApplication(sys.argv)
    initial = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    win = MainWindow(initial)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
