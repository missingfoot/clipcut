    # --- trim fields <-> scrubber sync ---

    def on_keyframe_fields_changed(self):
        self.start_keyframe_ref.setText(f"({format_time(self.keyframe_time(int(self.start_keyframe_edit.text() or 0)))})")
        end_idx = int(self.end_keyframe_edit.text()) if self.end_keyframe_edit.text() else max(0, len(self.keyframe_times) - 1)
        self.end_keyframe_ref.setText(f"({format_time(self.keyframe_time(end_idx))})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        self.scrubber.set_trim(start, end)
        self._syncing = False

    def on_frame_fields_changed(self):
        fps = self.video_fps or 30.0
        self.start_frame_ref.setText(f"({format_time(int(self.start_frame_edit.text() or 0) / fps)})")
        self.end_frame_ref.setText(f"({format_time(int(self.end_frame_edit.text() or 0) / fps)})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        self.scrubber.set_trim(start, end)
        self._syncing = False

    def on_cut_mode_changed(self, index):
        checked = bool(index)  # tab 0 = Keyframe, tab 1 = Frame
        self.frame_mode = checked
        if self.path:
            try:
                # Read from the mode we're leaving (checked already reflects the new
                # state by the time this handler fires, so get_trim_times() would read
                # the wrong, not-yet-populated field set).
                start, end = self.read_keyframe_fields_seconds() if checked else self.read_frame_fields_seconds()
            except ValueError:
                start, end = 0.0, self.duration
            self._syncing = True
            if checked:
                fps = self.video_fps or 30.0
                self.start_frame_edit.setText(str(round(start * fps)))
                self.end_frame_edit.setText(str(round(end * fps)))
            else:
                # Coming back from frame mode, re-snap to keyframes and show the
                # keyframe index - otherwise leaving frame mode would silently carry
                # over a value no keyframe field can actually represent.
                self.start_keyframe_edit.setText(str(self.keyframe_index_of(start)))
                self.end_keyframe_edit.setText(str(self.keyframe_index_of(end)))
            self._syncing = False
        self.update_suffix_placeholder()

    def on_trim_changed(self, start, end):
        if self._syncing:
            return
        self._syncing = True
        if self.frame_mode:
            fps = self.video_fps or 30.0
            self.start_frame_edit.setText(str(round(start * fps)))
            self.end_frame_edit.setText(str(round(end * fps)))
        else:
            self.start_keyframe_edit.setText(str(self.keyframe_index_of(start)))
            self.end_keyframe_edit.setText(str(self.keyframe_index_of(end)))
        self._syncing = False
        self.update_suffix_placeholder()

    def keyframe_time(self, idx):
        if not self.keyframe_times:
            return 0.0
        idx = max(0, min(len(self.keyframe_times) - 1, idx))
        return self.keyframe_times[idx]

    def keyframe_index_of(self, t):
        """Index of the nearest keyframe at-or-before t - where a stream-copy start
        (or, for symmetry, an end picked from this same list) actually lands."""
        if not self.keyframe_times:
            return 0
        idx = bisect.bisect_right(self.keyframe_times, t) - 1
        return max(0, idx)

    # --- playback controls ---

    def toggle_playback(self):
        if self.preview.player.playbackState() == QMediaPlayer.PlayingState:
            self.preview.player.pause()
        else:
            self.preview.player.play()

    def frame_duration(self):
        return 1.0 / self.video_fps if self.video_fps else 1.0

    def prev_keyframe_time(self, t):
        if not self.keyframe_times:
            return 0.0
        idx = bisect.bisect_left(self.keyframe_times, t) - 1
        return self.keyframe_times[max(0, idx)]

    def next_keyframe_time(self, t):
        if not self.keyframe_times:
            return t
        idx = bisect.bisect_right(self.keyframe_times, t)
        return self.keyframe_times[min(len(self.keyframe_times) - 1, idx)]

    def current_position(self):
        """The player's actual current position, in seconds. Reads the player directly
        rather than self.scrubber.position, which only updates when positionChanged
        arrives asynchronously - clicking a step/set button again before that signal
        lands would otherwise compute from a stale, pre-seek position."""
        return self.preview.player.position() / 1000.0

    def step_back(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = max(0.0, pos - self.frame_duration())
        else:
            new_pos = self.prev_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def step_forward(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = min(self.duration or 0.0, pos + self.frame_duration())
        else:
            new_pos = self.next_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def toggle_mute(self):
        muted = not self.preview.audio_output.isMuted()
        self.preview.audio_output.setMuted(muted)
        self.mute_button.setText("Unmute" if muted else "Mute")

    def set_start_from_playhead(self):
        pos = self.current_position()
        if self.frame_mode:
            fps = self.video_fps or 30.0
            self.start_frame_edit.setText(str(round(pos * fps)))
        else:
            self.start_keyframe_edit.setText(str(self.keyframe_index_of(pos)))

    def set_end_from_playhead(self):
        pos = self.current_position()
        if self.frame_mode:
            fps = self.video_fps or 30.0
            self.end_frame_edit.setText(str(round(pos * fps)))
        else:
            self.end_keyframe_edit.setText(str(self.keyframe_index_of(pos)))

    def on_playback_state_changed(self, state):
        self.play_button.setText("Pause" if state == QMediaPlayer.PlayingState else "Play")

    def on_player_position_changed(self, position_ms):
        seconds = position_ms / 1000
        self.scrubber.set_position(seconds)
        self.time_label.setText(f"{format_time(seconds)} / {format_time(self.duration or 0)}")

    def on_seek_requested(self, seconds):
        self.preview.player.setPosition(int(seconds * 1000))

    def on_remove_audio_toggled(self, checked):
        if checked:
            self.audio_only.setChecked(False)

    def on_audio_only_toggled(self, checked):
        if checked:
            self.remove_audio.setChecked(False)
        for widget in self.crop_edits:
            widget.setEnabled(not checked)

    def read_frame_fields_seconds(self):
        fps = self.video_fps or 30.0
        start_frame = int(self.start_frame_edit.text() or 0)
        end_frame = int(self.end_frame_edit.text() or 0)
        if start_frame < 0 or end_frame < 0:
            raise ValueError("frame numbers must be >= 0")
        start = start_frame / fps
        end = end_frame / fps
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("frame range leaves nothing to cut")
        return start, end

    def read_keyframe_fields_seconds(self):
        if not self.keyframe_times:
            raise ValueError("no keyframe data")
        last_idx = len(self.keyframe_times) - 1
        start_idx = int(self.start_keyframe_edit.text()) if self.start_keyframe_edit.text() else 0
        end_idx = int(self.end_keyframe_edit.text()) if self.end_keyframe_edit.text() else last_idx
        if start_idx < 0 or end_idx < 0:
            raise ValueError("keyframe numbers must be >= 0")
        start = self.keyframe_time(start_idx)
        end = self.keyframe_time(end_idx)
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("keyframe range leaves nothing to cut")
        return start, end

    def get_trim_times(self):
        if self.frame_mode:
            return self.read_frame_fields_seconds()
        return self.read_keyframe_fields_seconds()

    def get_crop(self):
        left, top, right, bottom = (int(edit.text() or 0) for edit in self.crop_edits)
        for name, v in (("left", left), ("top", top), ("right", right), ("bottom", bottom)):
            if v < 0:
                raise ValueError(f"crop {name} must be >= 0")
        crop_w = self.video_width - left - right
        crop_h = self.video_height - top - bottom
        has_crop = bool(left or top or right or bottom)
        if has_crop and (crop_w <= 0 or crop_h <= 0):
            raise ValueError("crop margins exceed frame size")
        return left, top, crop_w, crop_h, has_crop

    def compute_default_suffix(self):
        """Best-effort suffix reflecting current options, for the placeholder text."""
        if self.audio_only.isChecked():
            return "audio_only"
        try:
            start, end = self.get_trim_times()
            trimmed = start > 0 or end < (self.duration or 0)
        except ValueError:
            trimmed = False
        try:
            _, _, _, _, has_crop = self.get_crop() if self.path else (0, 0, 0, 0, False)
        except ValueError:
            has_crop = False

        parts = []
        if has_crop:
            parts.append("cropped")
        if self.remove_audio.isChecked():
            parts.append("no_audio")
        if trimmed or not parts:
            parts.append("cut")
        if self.frame_mode:
            parts.append("exact")
        return "_".join(parts)

    def update_suffix_placeholder(self):
        self.suffix_edit.setPlaceholderText(self.compute_default_suffix())

    def build_command(self):
        """Return (cmd, out_path, target_duration). Raises ValueError on bad input."""
        start, end = self.get_trim_times()
        target_duration = end - start
        append_text = self.suffix_edit.text().strip() or self.compute_default_suffix()
        cmd = ["ffmpeg", "-y", "-progress", "pipe:1", "-i", str(self.path), "-ss", str(start), "-to", str(end)]

        if self.audio_only.isChecked():
            out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}.m4a"))
            cmd += ["-vn", "-c:a", "copy", str(out_path)]
            return cmd, out_path, target_duration

        left, top, crop_w, crop_h, has_crop = self.get_crop()
        out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}{self.path.suffix}"))
        if has_crop:
            cmd += ["-vf", f"crop={crop_w}:{crop_h}:{left}:{top}",
                    "-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        elif self.frame_mode:
            cmd += ["-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        else:
            cmd += ["-c:v", "copy"]
        cmd += ["-an"] if self.remove_audio.isChecked() else ["-c:a", "copy"]
        cmd.append(str(out_path))
        return cmd, out_path, target_duration

    def advance_spinner(self):
        frame = self.spinner_frames[self.spinner_index]
        self.spinner_index = (self.spinner_index + 1) % len(self.spinner_frames)
        self.status.setText(f"{frame} Working... {self.progress_bar.value()}%")

    def on_process_output(self):
        if self.progress_target_duration <= 0:
            self.process.readAllStandardOutput()
            return
        data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        self.progress_buffer += data
        *complete_lines, self.progress_buffer = self.progress_buffer.split("\n")
        for line in complete_lines:
            seconds = parse_out_time_seconds(line.strip())
            if seconds is not None:
                pct = max(0, min(100, int(seconds / self.progress_target_duration * 100)))
                self.progress_bar.setValue(pct)

    def do_process(self):
        try:
            cmd, out_path, target_duration = self.build_command()
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            return

        self.pending_out_path = out_path
        self.progress_target_duration = target_duration
        self.progress_buffer = ""
        self.process_button.setEnabled(False)
        self.progress_bar.setValue(0)
        self.progress_bar.setVisible(True)
        self.spinner_index = 0
        self.advance_spinner()
        self.spinner_timer.start()

        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_process_finished)
        self.process.errorOccurred.connect(self.on_process_error)
        self.process.start(cmd[0], cmd[1:])

    def on_process_error(self, _error):
        self.spinner_timer.stop()
        self.progress_bar.setVisible(False)
        self.process_button.setEnabled(True)
        self.status.setText(f"Failed to launch ffmpeg: {self.process.errorString()}")
        self.process = None

    def on_process_finished(self, exit_code, _exit_status):
        self.spinner_timer.stop()
        self.progress_bar.setVisible(False)
        self.process_button.setEnabled(True)
        stderr = bytes(self.process.readAllStandardError()).decode(errors="replace")
        self.process = None

        if exit_code != 0:
            self.status.setText(f"ffmpeg failed:\n{stderr[-500:]}")
            return

        out_path = self.pending_out_path
        src_stat = self.path.stat()
        os.utime(out_path, (src_stat.st_atime, src_stat.st_mtime))
        self.status.setText(f"Saved: {out_path.name}")


def main():
    app = QApplication(sys.argv)
    initial = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    win = MainWindow(initial)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
