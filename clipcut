        sidebar_outer.setContentsMargins(0, 0, 0, 0)
        sidebar_outer.setSpacing(0)
        sidebar_widget = QWidget()
        sidebar_widget.setLayout(sidebar_outer)
        sidebar_widget.setFixedWidth(280)

