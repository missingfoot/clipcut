    # --- video preview <-> crop field sync ---

    def clear_crop(self):
        if not self.path:
            return
        self._syncing = True
        for field in self.crop_edits:
            field.clear()
        self._syncing = False
        self.preview.set_crop_pixels(0, 0, 0, 0)
        self.update_suffix_placeholder()
        self.update_crop_dims_label()

    def on_crop_field_edited(self, which):
        self.update_suffix_placeholder()
        self.update_crop_dims_label()
        if self._syncing or not self.path:
            return
        self._syncing = True
        try:
            edit = {"left": self.crop_left, "top": self.crop_top,
                    "right": self.crop_right, "bottom": self.crop_bottom}[which]
            new_value = int(edit.text() or 0)
            if new_value < 0:
                raise ValueError("crop value must be >= 0")
            left, top, right, bottom, locked = self.preview.set_edge(which, new_value)
            for target_edit, value in zip(self.crop_edits, (left, top, right, bottom)):
                target_edit.setText(str(value))
            if not locked:
                self.break_aspect_lock()
        except ValueError:
            pass
        finally:
            self._syncing = False
        self.update_crop_dims_label()

    def current_target_ratio(self):
        """The width/height ratio the aspect-ratio dropdown currently asks for, or None
        for "Free". This doubles as the corner handles' lock: see VideoPreview.locked_ratio."""
        label = self.aspect_combo.currentText()
        if label == "Free":
            return None
        num, _, den = label.partition(":")
        ratio = int(num) / int(den)
        return 1 / ratio if self.orient_vertical.isChecked() else ratio

    def on_aspect_ratio_selected(self, _index):
        if not self.path:
            return
        ratio = self.current_target_ratio()
        if ratio is None:
            left = top = right = bottom = 0
        else:
            vw, vh = self.video_width, self.video_height
            if vw / vh > ratio:
                crop_w = vw - round(vh * ratio)
                crop_h = 0
            else:
                crop_w = 0
                crop_h = vh - round(vw / ratio)
            left, right = crop_w // 2, crop_w - crop_w // 2
            top, bottom = crop_h // 2, crop_h - crop_h // 2
        # Suppress on_crop_field_edited while writing all four fields - each individual
        # setText would otherwise fire it against a still-partially-updated set of fields.
        self._syncing = True
        for edit, value in zip(self.crop_edits, (left, top, right, bottom)):
            edit.setText(str(value))
        self._syncing = False
        self.preview.set_crop_pixels(left, top, right, bottom)
        self.preview.set_all_guides_active(ratio is not None)
        self.preview.set_locked_ratio(ratio)
        self.update_crop_dims_label()

    def break_aspect_lock(self):
        """Drop the aspect-ratio dropdown back to Free. Called whenever an edit went
        through unlocked (Lock Aspect Ratio was off, or the box was empty), so a preset
        that no longer matches the actual box stops being displayed as selected."""
        if self.aspect_combo.currentIndex() != 0:
            self.aspect_combo.setCurrentIndex(0)
            self.preview.set_locked_ratio(None)

    def on_guides_changed(self, left, top, right, bottom, preserves_ratio):
        if not preserves_ratio:
            self.break_aspect_lock()
        if self._syncing:
            return
        self._syncing = True
        self.crop_left.setText(str(left))
        self.crop_top.setText(str(top))
        self.crop_right.setText(str(right))
        self.crop_bottom.setText(str(bottom))
        self._syncing = False
        self.update_suffix_placeholder()
        self.update_crop_dims_label()

    def update_crop_dims_label(self):
        if not self.path:
            self.crop_dims_label.setText("")
            return
        try:
            _, _, crop_w, crop_h, has_crop = self.get_crop()
        except ValueError:
            self.crop_dims_label.setText("")
            return
        if has_crop:
            self.crop_dims_label.setText(f"Cropped size: {crop_w} × {crop_h} px")
        else:
            self.crop_dims_label.setText(f"Source size: {self.video_width} × {self.video_height} px")

    # --- trim fields <-> scrubber sync ---

    def on_keyframe_fields_changed(self):
        self.start_keyframe_ref.setText(f"({format_time(self.keyframe_time(int(self.start_keyframe_edit.text() or 0)))})")
        end_time = self.keyframe_time(int(self.end_keyframe_edit.text())) if self.end_keyframe_edit.text() else (self.duration or 0)
        self.end_keyframe_ref.setText(f"({format_time(end_time)})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        has_trim = bool(self.start_keyframe_edit.text() or self.end_keyframe_edit.text())
        self.scrubber.set_trim(start, end, has_trim)
        self._syncing = False

    def on_frame_fields_changed(self):
        fps = self.video_fps or 30.0
        self.start_frame_ref.setText(f"({format_time(int(self.start_frame_edit.text() or 0) / fps)})")
        end_time = int(self.end_frame_edit.text()) / fps if self.end_frame_edit.text() else (self.duration or 0)
        self.end_frame_ref.setText(f"({format_time(end_time)})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        has_trim = bool(self.start_frame_edit.text() or self.end_frame_edit.text())
        self.scrubber.set_trim(start, end, has_trim)
        self._syncing = False

    def write_start_field(self, seconds):
        """Write a Start value, but leave the field blank instead of a literal "0" when
        it's at the very beginning - blank already means that, and a real "0" reads as
        if something deliberate were set."""
        if self.frame_mode:
            fps = self.video_fps or 30.0
            frame = round(seconds * fps)
            self.start_frame_edit.setText("" if frame <= 0 else str(frame))
        else:
            idx = self.keyframe_index_of(seconds)
            self.start_keyframe_edit.setText("" if idx <= 0 else str(idx))

    def write_end_field(self, seconds):
        """Write an End value, but leave the field blank instead of a concrete number
        when it's at (or past) the file's actual end - see write_start_field."""
        at_end = seconds >= self.duration - 0.01
        if self.frame_mode:
            fps = self.video_fps or 30.0
            self.end_frame_edit.setText("" if at_end else str(round(seconds * fps)))
        else:
            self.end_keyframe_edit.setText("" if at_end else str(self.keyframe_index_of(seconds)))

    def on_cut_mode_changed(self, index):
        checked = bool(index)  # tab 0 = Keyframe, tab 1 = Frame
        self.frame_mode = checked
        if self.path:
            try:
                # Read from the mode we're leaving (checked already reflects the new
                # state by the time this handler fires, so get_trim_times() would read
                # the wrong, not-yet-populated field set).
                start, end = self.read_keyframe_fields_seconds() if checked else self.read_frame_fields_seconds()
            except ValueError:
                start, end = 0.0, self.duration
            # self.frame_mode already reflects the tab just switched to, so these target
            # the right fields; blank stays blank rather than becoming a literal "0" or
            # a concrete End number that (for Keyframe mode) could cap it to a keyframe
            # well before the file's actual end.
            self._syncing = True
            self.write_start_field(start)
            self.write_end_field(end)
            self._syncing = False
        self.update_suffix_placeholder()

    def on_trim_changed(self, start, end):
        if self._syncing:
            return
        self._syncing = True
        self.write_start_field(start)
        self.write_end_field(end)
        self._syncing = False
        self.update_suffix_placeholder()

    def keyframe_time(self, idx):
        if not self.keyframe_times:
            return 0.0
        idx = max(0, min(len(self.keyframe_times) - 1, idx))
        return self.keyframe_times[idx]

    def keyframe_index_of(self, t):
        """Index of the nearest keyframe at-or-before t - where a stream-copy start
        (or, for symmetry, an end picked from this same list) actually lands."""
        if not self.keyframe_times:
            return 0
        idx = bisect.bisect_right(self.keyframe_times, t) - 1
        return max(0, idx)

    # --- playback controls ---

    def toggle_playback(self):
        if self.preview.player.playbackState() == QMediaPlayer.PlayingState:
            self.preview.player.pause()
        else:
            self.preview.player.play()

    def frame_duration(self):
        return 1.0 / self.video_fps if self.video_fps else 1.0

    # QMediaPlayer.setPosition() only takes whole milliseconds, so a seek to a keyframe
    # lands up to ~1ms short of its true (sub-ms-precision) timestamp; current_position()
    # then reads back that slightly-earlier value. Without this tolerance, the next
    # prev/next press treats "slightly before keyframe X" as still short of X and finds
    # the same one again - permanently stuck, especially with closely-spaced keyframes.
    KEYFRAME_SEEK_EPS = 0.002

    def prev_keyframe_time(self, t):
        if not self.keyframe_times:
            return 0.0
        idx = bisect.bisect_left(self.keyframe_times, t - self.KEYFRAME_SEEK_EPS) - 1
        return self.keyframe_times[max(0, idx)]

    def next_keyframe_time(self, t):
        if not self.keyframe_times:
            return t
        idx = bisect.bisect_right(self.keyframe_times, t + self.KEYFRAME_SEEK_EPS)
        return self.keyframe_times[min(len(self.keyframe_times) - 1, idx)]

    def current_position(self):
        """The player's actual current position, in seconds. Reads the player directly
        rather than self.scrubber.position, which only updates when positionChanged
        arrives asynchronously - clicking a step/set button again before that signal
        lands would otherwise compute from a stale, pre-seek position."""
        return self.preview.player.position() / 1000.0

    def step_back(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = max(0.0, pos - self.frame_duration())
        else:
            new_pos = self.prev_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def step_forward(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = min(self.duration or 0.0, pos + self.frame_duration())
        else:
            new_pos = self.next_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def toggle_mute(self):
        muted = not self.preview.audio_output.isMuted()
        self.preview.audio_output.setMuted(muted)
        self.mute_button.setText("Unmute" if muted else "Mute")

    def toggle_actual_size(self):
        """Toggle the preview between scaled-to-fit and native pixel size; the window
        and sidebar are untouched, only how the video renders within the preview panel."""
        actual = not self.preview.zoom_actual
        self.preview.set_zoom_actual(actual)
        self.actual_size_button.setText("Fit" if actual else "100%")

    def set_start_from_playhead(self):
        self.write_start_field(self.current_position())

    def set_end_from_playhead(self):
        self.write_end_field(self.current_position())

    def on_playback_state_changed(self, state):
        self.play_button.setText("Pause" if state == QMediaPlayer.PlayingState else "Play")

    def on_player_position_changed(self, position_ms):
        seconds = position_ms / 1000
        self.scrubber.set_position(seconds)
        self.time_label.setText(f"{format_time(seconds)} / {format_time(self.duration or 0)}")

    def on_seek_requested(self, seconds):
        self.preview.player.setPosition(int(seconds * 1000))

    def on_remove_audio_toggled(self, checked):
        if checked:
            self.audio_only.setChecked(False)

    def on_audio_only_toggled(self, checked):
        if checked:
            self.remove_audio.setChecked(False)
        for widget in self.crop_edits:
            widget.setEnabled(not checked)

    def read_frame_fields_seconds(self):
        fps = self.video_fps or 30.0
        start_frame = int(self.start_frame_edit.text() or 0)
        if start_frame < 0:
            raise ValueError("frame numbers must be >= 0")
        start = start_frame / fps
        # Blank End means "through the end of the file", matching blank Start meaning
        # "from the beginning" - not frame 0, which would make every blank-End cut empty.
        if self.end_frame_edit.text():
            end_frame = int(self.end_frame_edit.text())
            if end_frame < 0:
                raise ValueError("frame numbers must be >= 0")
            end = end_frame / fps
        else:
            end = self.duration
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("frame range leaves nothing to cut")
        return start, end

    def read_keyframe_fields_seconds(self):
        if not self.keyframe_times:
            raise ValueError("no keyframe data")
        start_idx = int(self.start_keyframe_edit.text()) if self.start_keyframe_edit.text() else 0
        if start_idx < 0:
            raise ValueError("keyframe numbers must be >= 0")
        start = self.keyframe_time(start_idx)
        # Blank End means "through the end of the file". Unlike Start, the end of a
        # stream-copy cut doesn't need to land on a keyframe, so it isn't capped to the
        # last keyframe's time - which can sit well before the file's actual end (e.g. a
        # clip with only one keyframe would otherwise default End to time 0).
        if self.end_keyframe_edit.text():
            end_idx = int(self.end_keyframe_edit.text())
            if end_idx < 0:
                raise ValueError("keyframe numbers must be >= 0")
            end = self.keyframe_time(end_idx)
        else:
            end = self.duration
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("keyframe range leaves nothing to cut")
        return start, end

    def get_trim_times(self):
        if self.frame_mode:
            return self.read_frame_fields_seconds()
        return self.read_keyframe_fields_seconds()

    def get_crop(self):
        left, top, right, bottom = (int(edit.text() or 0) for edit in self.crop_edits)
        for name, v in (("left", left), ("top", top), ("right", right), ("bottom", bottom)):
            if v < 0:
                raise ValueError(f"crop {name} must be >= 0")
        crop_w = self.video_width - left - right
        crop_h = self.video_height - top - bottom
        has_crop = bool(left or top or right or bottom)
        if has_crop and (crop_w <= 0 or crop_h <= 0):
            raise ValueError("crop margins exceed frame size")
        return left, top, crop_w, crop_h, has_crop

    def compute_default_suffix(self):
        """Best-effort suffix reflecting current options, for the placeholder text."""
        if self.audio_only.isChecked():
            return "audio_only"
        try:
            start, end = self.get_trim_times()
            trimmed = start > 0 or end < (self.duration or 0)
        except ValueError:
            trimmed = False
        try:
            _, _, _, _, has_crop = self.get_crop() if self.path else (0, 0, 0, 0, False)
        except ValueError:
            has_crop = False

        parts = []
        if has_crop:
            parts.append("cropped")
        if self.remove_audio.isChecked():
            parts.append("no_audio")
        if trimmed or not parts:
            parts.append("cut")
        if self.frame_mode:
            parts.append("exact")
        return "_".join(parts)

    def update_suffix_placeholder(self):
        self.suffix_edit.setPlaceholderText(self.compute_default_suffix())

    def build_command(self):
        """Return (cmd, out_path, target_duration). Raises ValueError on bad input."""
        start, end = self.get_trim_times()
        target_duration = end - start
        append_text = self.suffix_edit.text().strip() or self.compute_default_suffix()
        cmd = ["ffmpeg", "-y", "-progress", "pipe:1", "-i", str(self.path), "-ss", str(start), "-to", str(end)]

        if self.audio_only.isChecked():
            out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}.m4a"))
            cmd += ["-vn", "-c:a", "copy", str(out_path)]
            return cmd, out_path, target_duration

        left, top, crop_w, crop_h, has_crop = self.get_crop()
        out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}{self.path.suffix}"))
        if has_crop:
            cmd += ["-vf", f"crop={crop_w}:{crop_h}:{left}:{top}",
                    "-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        elif self.frame_mode:
            cmd += ["-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        else:
            cmd += ["-c:v", "copy"]
        cmd += ["-an"] if self.remove_audio.isChecked() else ["-c:a", "copy"]
        cmd.append(str(out_path))
        return cmd, out_path, target_duration

    def advance_spinner(self):
        frame = self.spinner_frames[self.spinner_index]
        self.spinner_index = (self.spinner_index + 1) % len(self.spinner_frames)
        self.status.setText(f"{frame} Working... {self.progress_percent}%")

    def on_process_output(self):
        if self.progress_target_duration <= 0:
            self.process.readAllStandardOutput()
            return
        data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        self.progress_buffer += data
        *complete_lines, self.progress_buffer = self.progress_buffer.split("\n")
        for line in complete_lines:
            seconds = parse_out_time_seconds(line.strip())
            if seconds is not None:
                pct = max(0, min(100, int(seconds / self.progress_target_duration * 100)))
                self.progress_percent = pct

    def do_process(self):
        try:
            cmd, out_path, target_duration = self.build_command()
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            self.error_details_button.setVisible(False)
            return

        self.pending_out_path = out_path
        self.progress_target_duration = target_duration
        self.progress_buffer = ""
        self.error_details_button.setVisible(False)
        self.process_button.setEnabled(False)
        self.progress_percent = 0
        self.spinner_index = 0
        self.advance_spinner()
        self.spinner_timer.start()

        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_process_finished)
        self.process.errorOccurred.connect(self.on_process_error)
        self.process.start(cmd[0], cmd[1:])

    def report_error(self, summary, details):
        self.status.setText(summary)
        self.error_details = details
        self.error_details_button.setVisible(bool(details))

    def show_error_details(self):
        dialog = QDialog(self)
        dialog.setWindowTitle("Error Details")
        dialog.resize(600, 400)
        layout = QVBoxLayout(dialog)
        text = QPlainTextEdit(self.error_details)
        text.setReadOnly(True)
        layout.addWidget(text)
        close_button = QPushButton("Close")
        close_button.clicked.connect(dialog.close)
        layout.addWidget(close_button)
        dialog.exec()

    def on_process_error(self, _error):
        self.spinner_timer.stop()
        self.process_button.setEnabled(True)
        self.report_error("Failed to launch ffmpeg", self.process.errorString())
        self.process = None

    def on_process_finished(self, exit_code, _exit_status):
        self.spinner_timer.stop()
        self.process_button.setEnabled(True)
        stderr = bytes(self.process.readAllStandardError()).decode(errors="replace")
        self.process = None

        if exit_code != 0:
            self.report_error("ffmpeg failed", stderr)
            return

        out_path = self.pending_out_path
        src_stat = self.path.stat()
        os.utime(out_path, (src_stat.st_atime, src_stat.st_mtime))
        self.error_details_button.setVisible(False)
        self.status.setText("Saved successfully")


def main():
    app = QApplication(sys.argv)
    initial = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    win = MainWindow(initial)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
