        sidebar.addWidget(self.progress_bar)

        self.status = QLabel("")
        self.status.setWordWrap(True)
        sidebar.addWidget(self.status)
        sidebar.addStretch()

        root.addWidget(sidebar_widget)

        self.setAcceptDrops(True)

        self.preview.player.positionChanged.connect(self.on_player_position_changed)
        self.preview.player.playbackStateChanged.connect(self.on_playback_state_changed)

        if initial_path:
            self.load_file(initial_path)

    OVERLAY_MARGIN = 24

    def overlay_rect(self):
        m = self.OVERLAY_MARGIN
        return self.centralWidget().rect().adjusted(m, m, -m, -m)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
            self.drop_overlay.setGeometry(self.overlay_rect())
            self.drop_overlay.show()
            self.drop_overlay.raise_()

    def dropEvent(self, event):
        urls = event.mimeData().urls()
        if urls:
            self.load_file(Path(urls[0].toLocalFile()))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        if self.drop_overlay.isVisible():
            self.drop_overlay.setGeometry(self.overlay_rect())

    def browse_for_file(self):
        filename, _filter = QFileDialog.getOpenFileName(self, "Open video", str(Path.home()), "Videos (*.mp4 *.mkv *.mov *.webm *.avi);;All files (*)")
        if filename:
            self.load_file(Path(filename))

    def load_file(self, path):
        try:
            w, h, duration = probe(path)
        except Exception as e:
            self.status.setText(f"Failed to read file: {e}")
            return
        self.path = path
        self.video_width, self.video_height = w, h
        self.duration = duration
        self.filename_label.setText(f"{path.name}  ({w}x{h}, {duration:.1f}s)")
        self.browse_button.setText("Replace File...")
        for field in self.time_edits:
            field.clear()
        for field in self.crop_edits:
            field.clear()
        self.process_button.setEnabled(True)
        self.play_button.setEnabled(True)
        self.mute_button.setEnabled(True)
        self.status.setText("")
        self.update_suffix_placeholder()

        self.preview.load(path, w, h)
        self.scrubber.set_duration(duration)
        self.time_label.setText(f"0:00 / {format_time(duration)}")

    # --- video preview <-> crop field sync ---

    def on_crop_fields_changed(self):
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        self._syncing = True
        try:
            left = int(self.crop_left.text() or 0)
            top = int(self.crop_top.text() or 0)
            right = int(self.crop_right.text() or 0)
            bottom = int(self.crop_bottom.text() or 0)
            self.preview.set_crop_pixels(left, top, right, bottom)
        except ValueError:
            pass
        finally:
            self._syncing = False

    def on_guides_changed(self, left, top, right, bottom):
        if self._syncing:
            return
        self._syncing = True
        self.crop_left.setText(str(left))
        self.crop_top.setText(str(top))
        self.crop_right.setText(str(right))
        self.crop_bottom.setText(str(bottom))
        self._syncing = False
        self.update_suffix_placeholder()

    # --- trim fields <-> scrubber sync ---

    def on_time_fields_changed(self):
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        self.scrubber.set_trim(start, end)
        self._syncing = False

    def on_trim_changed(self, start, end):
        if self._syncing:
            return
        self._syncing = True
        h, m, s = seconds_to_hms(start)
        self.start_h.setText(str(h))
        self.start_m.setText(str(m))
        self.start_s.setText(str(s))
        h, m, s = seconds_to_hms(self.duration - end)
        self.end_h.setText(str(h))
        self.end_m.setText(str(m))
        self.end_s.setText(str(s))
        self._syncing = False
        self.update_suffix_placeholder()

    # --- playback controls ---

    def toggle_playback(self):
        if self.preview.player.playbackState() == QMediaPlayer.PlayingState:
            self.preview.player.pause()
        else:
            self.preview.player.play()

    def toggle_mute(self):
        muted = not self.preview.audio_output.isMuted()
        self.preview.audio_output.setMuted(muted)
        self.mute_button.setText("Unmute" if muted else "Mute")

    def on_playback_state_changed(self, state):
        self.play_button.setText("Pause" if state == QMediaPlayer.PlayingState else "Play")

    def on_player_position_changed(self, position_ms):
        seconds = position_ms / 1000
        self.scrubber.set_position(seconds)
        self.time_label.setText(f"{format_time(seconds)} / {format_time(self.duration or 0)}")

    def on_seek_requested(self, seconds):
        self.preview.player.setPosition(int(seconds * 1000))

    def on_remove_audio_toggled(self, checked):
        if checked:
            self.audio_only.setChecked(False)

    def on_audio_only_toggled(self, checked):
        if checked:
            self.remove_audio.setChecked(False)
        for widget in self.crop_edits:
            widget.setEnabled(not checked)

    @staticmethod
    def hms_to_seconds(h_edit, m_edit, s_edit):
        h = int(h_edit.text() or 0)
        m = int(m_edit.text() or 0)
        s = int(s_edit.text() or 0)
        if h < 0 or m < 0 or s < 0:
            raise ValueError("time fields must be >= 0")
        return h * 3600 + m * 60 + s

    def get_trim_times(self):
        chop_start = self.hms_to_seconds(self.start_h, self.start_m, self.start_s)
        chop_end = self.hms_to_seconds(self.end_h, self.end_m, self.end_s)
        start = chop_start
        end = self.duration - chop_end
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("chop amounts leave nothing to cut")
        return start, end

    def get_crop(self):
        left, top, right, bottom = (int(edit.text() or 0) for edit in self.crop_edits)
        for name, v in (("left", left), ("top", top), ("right", right), ("bottom", bottom)):
            if v < 0:
                raise ValueError(f"crop {name} must be >= 0")
        crop_w = self.video_width - left - right
        crop_h = self.video_height - top - bottom
        has_crop = bool(left or top or right or bottom)
        if has_crop and (crop_w <= 0 or crop_h <= 0):
            raise ValueError("crop margins exceed frame size")
        return left, top, crop_w, crop_h, has_crop

    def compute_default_suffix(self):
        """Best-effort suffix reflecting current options, for the placeholder text."""
        if self.audio_only.isChecked():
            return "audio_only"
        try:
            chop_start = self.hms_to_seconds(self.start_h, self.start_m, self.start_s)
            chop_end = self.hms_to_seconds(self.end_h, self.end_m, self.end_s)
            trimmed = chop_start > 0 or chop_end > 0
        except ValueError:
            trimmed = False
        try:
            _, _, _, _, has_crop = self.get_crop() if self.path else (0, 0, 0, 0, False)
        except ValueError:
            has_crop = False

        parts = []
        if has_crop:
            parts.append("cropped")
        if self.remove_audio.isChecked():
            parts.append("no_audio")
        if trimmed or not parts:
            parts.append("cut")
        return "_".join(parts)

    def update_suffix_placeholder(self):
        self.suffix_edit.setPlaceholderText(self.compute_default_suffix())

    def build_command(self):
        """Return (cmd, out_path, target_duration). Raises ValueError on bad input."""
        start, end = self.get_trim_times()
        target_duration = end - start
        append_text = self.suffix_edit.text().strip() or self.compute_default_suffix()
        cmd = ["ffmpeg", "-y", "-progress", "pipe:1", "-i", str(self.path), "-ss", str(start), "-to", str(end)]

        if self.audio_only.isChecked():
            out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}.m4a"))
            cmd += ["-vn", "-c:a", "copy", str(out_path)]
            return cmd, out_path, target_duration

        left, top, crop_w, crop_h, has_crop = self.get_crop()
        out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}{self.path.suffix}"))
        if has_crop:
            cmd += ["-vf", f"crop={crop_w}:{crop_h}:{left}:{top}",
                    "-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        else:
            cmd += ["-c:v", "copy"]
        cmd += ["-an"] if self.remove_audio.isChecked() else ["-c:a", "copy"]
        cmd.append(str(out_path))
        return cmd, out_path, target_duration

    def advance_spinner(self):
        frame = self.spinner_frames[self.spinner_index]
        self.spinner_index = (self.spinner_index + 1) % len(self.spinner_frames)
        self.status.setText(f"{frame} Working... {self.progress_bar.value()}%")

    def on_process_output(self):
        if self.progress_target_duration <= 0:
            self.process.readAllStandardOutput()
            return
        data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        self.progress_buffer += data
        *complete_lines, self.progress_buffer = self.progress_buffer.split("\n")
        for line in complete_lines:
            seconds = parse_out_time_seconds(line.strip())
            if seconds is not None:
                pct = max(0, min(100, int(seconds / self.progress_target_duration * 100)))
                self.progress_bar.setValue(pct)

    def do_process(self):
        try:
            cmd, out_path, target_duration = self.build_command()
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            return

        self.pending_out_path = out_path
        self.progress_target_duration = target_duration
        self.progress_buffer = ""
        self.process_button.setEnabled(False)
        self.progress_bar.setValue(0)
        self.progress_bar.setVisible(True)
        self.spinner_index = 0
        self.advance_spinner()
        self.spinner_timer.start()

        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_process_finished)
        self.process.errorOccurred.connect(self.on_process_error)
        self.process.start(cmd[0], cmd[1:])

    def on_process_error(self, _error):
        self.spinner_timer.stop()
        self.progress_bar.setVisible(False)
        self.process_button.setEnabled(True)
        self.status.setText(f"Failed to launch ffmpeg: {self.process.errorString()}")
        self.process = None

    def on_process_finished(self, exit_code, _exit_status):
        self.spinner_timer.stop()
        self.progress_bar.setVisible(False)
        self.process_button.setEnabled(True)
        stderr = bytes(self.process.readAllStandardError()).decode(errors="replace")
        self.process = None

        if exit_code != 0:
            self.status.setText(f"ffmpeg failed:\n{stderr[-500:]}")
            return

        out_path = self.pending_out_path
        src_stat = self.path.stat()
        os.utime(out_path, (src_stat.st_atime, src_stat.st_mtime))
        self.status.setText(f"Saved: {out_path.name}")


def main():
    app = QApplication(sys.argv)
    initial = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    win = MainWindow(initial)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
