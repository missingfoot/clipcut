            self.load_file(Path(filename))

    def load_file(self, path):
        try:
            w, h, duration, fps = probe(path)
        except Exception as e:
            self.status.setText(f"Failed to read file: {e}")
            return
        self.path = path
        self.video_width, self.video_height = w, h
        self.duration = duration
        self.video_fps = fps
        self.keyframe_times = get_keyframe_times(path)
        self.filename_label.setText(f"{path.name}  ({w}x{h}, {duration:.1f}s)")
        self.browse_button.setText("Replace File...")
        self.start_keyframe_edit.clear()
        # Blank End means "use the range" everywhere else, so default it explicitly
        # to the last keyframe rather than leaving it implying index 0.
        self.end_keyframe_edit.setText(str(max(0, len(self.keyframe_times) - 1)))
        for field in self.frame_edits:
            field.clear()
        for field in self.crop_edits:
            field.clear()
        self.process_button.setEnabled(True)
        self.play_button.setEnabled(True)
        self.step_back_button.setEnabled(True)
        self.step_forward_button.setEnabled(True)
        self.mute_button.setEnabled(True)
        self.remove_file_button.setEnabled(True)
        self.set_start_button.setEnabled(True)
        self.set_end_button.setEnabled(True)
