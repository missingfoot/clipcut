        self.scrubber.set_keyframes([])
        self.time_label.setText("0:00 / 0:00")

    # --- video preview <-> crop field sync ---

    def recenter_crop(self):
        """Keep the crop box's current size, just re-center it on the frame."""
        if not self.path:
            return
        left, top, right, bottom = self.preview.crop
        box_w = self.video_width - left - right
        box_h = self.video_height - top - bottom
        if box_w <= 0 or box_h <= 0:
            return
        new_left = (self.video_width - box_w) // 2
        new_right = self.video_width - box_w - new_left
        new_top = (self.video_height - box_h) // 2
        new_bottom = self.video_height - box_h - new_top
        self._syncing = True
        for edit, value in zip(self.crop_edits, (new_left, new_top, new_right, new_bottom)):
            edit.setText(str(value))
        self._syncing = False
        self.preview.set_crop_pixels(new_left, new_top, new_right, new_bottom)
        self.set_current_crop(new_left, new_top, new_right, new_bottom)
        self.update_crop_size_fields()

    def on_crop_size_field_edited(self, which):
        """Typing an exact pixel width/height overrides the crop directly, acting like a
        corner-scale: when Lock Aspect Ratio is on (and a real box already exists), the
        edited dimension drives the other one via the current ratio, same as dragging a
        corner would. Unlocked, both are independent and this breaks any active preset."""
        if self._syncing or not self.path:
            return
        self._syncing = True
        try:
            w_text = self.crop_width_edit.text()
            h_text = self.crop_height_edit.text()
            ratio = self.preview.effective_ratio()
            if ratio and which == "width" and w_text:
                target_w = int(w_text)
                target_h = target_w / ratio
            elif ratio and which == "height" and h_text:
                target_h = int(h_text)
                target_w = target_h * ratio
            else:
                target_w = int(w_text) if w_text else self.video_width
                target_h = int(h_text) if h_text else self.video_height
            if target_w <= 0 or target_h <= 0:
                raise ValueError("size must be positive")
            # Cap both dimensions together so a target that would overflow the frame on
            # one axis scales the whole box back instead of just clamping that axis and
            # breaking the ratio.
            over = max(target_w / self.video_width, target_h / self.video_height)
            if over > 1:
                target_w /= over
                target_h /= over
            target_w = int(round(target_w))
            target_h = int(round(target_h))

            left0, top0, right0, bottom0 = self.preview.crop
            center_x = (left0 + (self.video_width - right0)) / 2
            center_y = (top0 + (self.video_height - bottom0)) / 2
            # Derive the opposite edge from the total instead of rounding both edges
            # independently - two separate round()s of complementary .5 values can both
            # round the same way (Python's banker's rounding), leaving them short of the
            # target width/height entirely instead of off by a pixel.
            left = max(0, min(self.video_width - 1, int(round(center_x - target_w / 2))))
            right = max(0, min(self.video_width - 1, self.video_width - target_w - left))
            top = max(0, min(self.video_height - 1, int(round(center_y - target_h / 2))))
            bottom = max(0, min(self.video_height - 1, self.video_height - target_h - top))
            for edit, value in zip(self.crop_edits, (left, top, right, bottom)):
                edit.setText(str(value))
            if ratio:
                self.crop_width_edit.setText(str(target_w))
                self.crop_height_edit.setText(str(target_h))
                self.preview.apply_scaled_crop(left, top, right, bottom)
                self.set_current_crop(left, top, right, bottom)
            else:
                self.preview.set_crop_pixels(left, top, right, bottom)
                self.set_current_crop(left, top, right, bottom)
                self.break_aspect_lock()
        except ValueError:
            pass
        finally:
            self._syncing = False
        self.update_crop_size_fields()
        self.update_suffix_placeholder()

    def on_crop_position_field_edited(self, which):
        """Typing an exact X/Y moves the crop box - same translation dragging the crop
        interior does, so it's ratio-agnostic (a move never changes the box's shape) and
        always applies regardless of the aspect-ratio lock."""
        if self._syncing or not self.path:
            return
        self._syncing = True
        try:
            left0, top0, right0, bottom0 = self.preview.crop
            if which == "x":
                box_w = self.video_width - left0 - right0
                x_text = self.crop_x_edit.text()
                new_x = max(0, min(self.video_width - box_w, int(x_text) if x_text else 0))
                left, right = new_x, self.video_width - box_w - new_x
                top, bottom = top0, bottom0
            else:
                box_h = self.video_height - top0 - bottom0
                y_text = self.crop_y_edit.text()
                new_y = max(0, min(self.video_height - box_h, int(y_text) if y_text else 0))
                top, bottom = new_y, self.video_height - box_h - new_y
                left, right = left0, right0
            for edit, value in zip(self.crop_edits, (left, top, right, bottom)):
                edit.setText(str(value))
            self.preview.apply_scaled_crop(left, top, right, bottom)
            self.set_current_crop(left, top, right, bottom)
        except ValueError:
            pass
        finally:
            self._syncing = False
        self.update_crop_size_fields()
        self.update_suffix_placeholder()

    def clear_crop(self):
        if not self.path:
            return
        self._syncing = True
        for field in self.crop_edits:
            field.clear()
        self._syncing = False
        self.preview.set_crop_pixels(0, 0, 0, 0)
        self.set_current_crop(0, 0, 0, 0)
        self.update_suffix_placeholder()
        self.update_crop_size_fields()

    def on_crop_field_edited(self, which):
        self.update_suffix_placeholder()
        self.update_crop_size_fields()
        if self._syncing or not self.path:
            return
        self._syncing = True
        try:
            edit = {"left": self.crop_left, "top": self.crop_top,
                    "right": self.crop_right, "bottom": self.crop_bottom}[which]
            new_value = int(edit.text() or 0)
            if new_value < 0:
                raise ValueError("crop value must be >= 0")
            left, top, right, bottom, locked = self.preview.set_edge(which, new_value)
            self.set_current_crop(left, top, right, bottom)
            for target_edit, value in zip(self.crop_edits, (left, top, right, bottom)):
                target_edit.setText(str(value))
            if not locked:
                self.break_aspect_lock()
        except ValueError:
            pass
        finally:
            self._syncing = False
        self.update_crop_size_fields()

    def current_target_ratio(self):
        """The width/height ratio the Preset dropdown currently asks for, or None
        for "None". This doubles as the corner handles' lock: see VideoPreview.locked_ratio."""
        label = self.aspect_combo.currentText()
        if label == "None":
            return None
        if label == "Current":
            # The video's own native ratio - applying it always crops to
            # (0,0,0,0) (nothing needs trimming, it already matches), but
            # locks that ratio so a corner-resize scales down within the same
            # shape without the user needing to know or pick 1:1 vs 16:9 etc.
            if not self.video_width or not self.video_height:
                return None
            ratio = self.video_width / self.video_height
        else:
            num, _, den = label.partition(":")
            ratio = int(num) / int(den)
        return 1 / ratio if self.orient_vertical.isChecked() else ratio

    def match_aspect_preset(self, crop):
        """Which Preset dropdown index (0 = "None") this crop tuple exactly
        matches, given the current video size/orientation - keeps the dropdown
        honestly reflecting whatever crop is actually on screen (per cut, once
        Per-Cut Crop is on) instead of just remembering whichever preset was
        picked last, possibly for a different cut entirely.

        Treats crop == (0,0,0,0) as "None" even though some preset might
        technically also compute an all-zero crop (e.g. a video whose native
        ratio already matches "4:3") - a genuinely untouched cut ALSO displays
        as (0,0,0,0), and there's no way to tell the two apart from the crop
        value alone, so this stays on the side that doesn't silently engage an
        aspect lock nobody asked for. on_aspect_ratio_selected() overrides
        this explicitly for the one case that needs to win anyway: a preset
        the user just deliberately picked, even one that happens to produce
        an all-zero crop."""
        if crop == (0, 0, 0, 0) or not self.video_width or not self.video_height:
            return 0
        vw, vh = self.video_width, self.video_height
        for i in range(1, self.aspect_combo.count()):
            label = self.aspect_combo.itemText(i)
            if label == "Current":
                continue  # not in "W:H" text form - always resolves to (0,0,0,0) anyway,
                # already handled by the shortcut above
            num, _, den = label.partition(":")
            ratio = int(num) / int(den)
            if self.orient_vertical.isChecked():
                ratio = 1 / ratio
            if vw / vh > ratio:
                crop_w, crop_h = vw - round(vh * ratio), 0
            else:
                crop_w, crop_h = 0, vh - round(vw / ratio)
            expected = (crop_w // 2, crop_h // 2, crop_w - crop_w // 2, crop_h - crop_h // 2)
            if crop == expected:
                return i
        return 0

    def on_orientation_changed(self, _checked):
        """Horizontal/Vertical only changes how a *preset ratio* is interpreted
        (current_target_ratio() flips it) - with no preset engaged ("None"),
        orientation has nothing to reinterpret, so this must NOT fall through
        to on_aspect_ratio_selected(), which would unconditionally recompute
        the crop as (0,0,0,0) and destroy any freeform/manual crop in
        progress. With a preset engaged, re-apply it under the new
        orientation, same as picking it fresh from the dropdown."""
        if not self.path or self.aspect_combo.currentText() == "None":
            return
        self.on_aspect_ratio_selected(self.aspect_combo.currentIndex())

    def on_aspect_ratio_selected(self, _index):
        if not self.path:
            return
        chosen_index = self.aspect_combo.currentIndex()
        ratio = self.current_target_ratio()
        if ratio is None:
            left = top = right = bottom = 0
        else:
            vw, vh = self.video_width, self.video_height
            if vw / vh > ratio:
                crop_w = vw - round(vh * ratio)
                crop_h = 0
            else:
                crop_w = 0
                crop_h = vh - round(vw / ratio)
            left, right = crop_w // 2, crop_w - crop_w // 2
            top, bottom = crop_h // 2, crop_h - crop_h // 2
        # show_crop() blanks zero-valued edges (matching every other display path -
        # select_cut, per-cut-crop toggle) instead of writing a literal "0", and
        # re-syncs the Preset dropdown + guide-lock from the crop itself.
        self.show_crop((left, top, right, bottom))
        self.set_current_crop(left, top, right, bottom)
        if ratio is not None:
            # show_crop()'s own reverse-inference (match_aspect_preset) treats an
            # all-zero crop as "None" by default, to avoid falsely engaging a lock
            # for cuts that were never touched - but this preset was just
            # deliberately picked, so it must stick even when applying it produces
            # a (0,0,0,0) crop (the video already matches this ratio exactly).
            self.aspect_combo.setCurrentIndex(chosen_index)
            self.preview.set_locked_ratio(ratio)

    def break_aspect_lock(self):
        """Drop the Preset dropdown back to None. Called whenever an edit went
        through unlocked (Lock Aspect Ratio was off, or the box was empty), so a preset
        that no longer matches the actual box stops being displayed as selected."""
        if self.aspect_combo.currentIndex() != 0:
            self.aspect_combo.setCurrentIndex(0)
            self.preview.set_locked_ratio(None)

    def on_guides_changed(self, left, top, right, bottom, preserves_ratio):
        self.set_current_crop(left, top, right, bottom)
        if not preserves_ratio:
            self.break_aspect_lock()
        if self._syncing:
            return
        self._syncing = True
        self.crop_left.setText(str(left))
        self.crop_top.setText(str(top))
        self.crop_right.setText(str(right))
        self.crop_bottom.setText(str(bottom))
        self._syncing = False
        self.update_suffix_placeholder()
        self.update_crop_size_fields()

    def update_crop_size_fields(self):
        """Keep the Size and Position fields showing the crop's current pixel dimensions
        and top-left corner - blank (Size shows the source size as a placeholder,
        Position shows 0,0) when there's no crop at all."""
        if not self.path:
            return
        try:
            left, top, crop_w, crop_h, has_crop = self.get_crop()
        except ValueError:
            return
        was_syncing = self._syncing
        self._syncing = True
        if has_crop:
            self.crop_width_edit.setText(str(crop_w))
            self.crop_height_edit.setText(str(crop_h))
            self.crop_x_edit.setText(str(left))
            self.crop_y_edit.setText(str(top))
        else:
            self.crop_width_edit.clear()
            self.crop_height_edit.clear()
            self.crop_x_edit.clear()
            self.crop_y_edit.clear()
        self._syncing = was_syncing

    # --- trim fields <-> scrubber sync ---

    def on_keyframe_fields_changed(self):
        self.start_keyframe_ref.setText(f"({format_time(self.keyframe_time(int(self.start_keyframe_edit.text() or 0)))})")
        end_time = self.keyframe_time(int(self.end_keyframe_edit.text())) if self.end_keyframe_edit.text() else (self.duration or 0)
        self.end_keyframe_ref.setText(f"({format_time(end_time)})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        self.sync_active_cut_from_widgets()
        self.refresh_timeline_cuts()
        self._syncing = False
        self.refresh_cut_list()

    def on_frame_fields_changed(self):
        fps = self.video_fps or 30.0
        self.start_frame_ref.setText(f"({format_time(int(self.start_frame_edit.text() or 0) / fps)})")
        end_time = int(self.end_frame_edit.text()) / fps if self.end_frame_edit.text() else (self.duration or 0)
        self.end_frame_ref.setText(f"({format_time(end_time)})")
        self.update_suffix_placeholder()
        if self._syncing or not self.path:
            return
        try:
            start, end = self.get_trim_times()
        except ValueError:
            return
        self._syncing = True
        self.sync_active_cut_from_widgets()
        self.refresh_timeline_cuts()
        self._syncing = False
        self.refresh_cut_list()

    def write_start_field(self, seconds):
        """Write a Start value, but leave the field blank instead of a literal "0" when
        it's at the very beginning - blank already means that, and a real "0" reads as
        if something deliberate were set."""
        if self.frame_mode:
            fps = self.video_fps or 30.0
            frame = round(seconds * fps)
            self.start_frame_edit.setText("" if frame <= 0 else str(frame))
        else:
            idx = self.keyframe_index_of(seconds)
            self.start_keyframe_edit.setText("" if idx <= 0 else str(idx))
        self.sync_active_cut_from_widgets()
        self.refresh_timeline_cuts()
        self.refresh_cut_list()

    def write_end_field(self, seconds):
        """Write an End value, but leave the field blank instead of a concrete number
        when it's at (or past) the file's actual end - see write_start_field."""
        at_end = seconds >= self.duration - 0.01
        if self.frame_mode:
            fps = self.video_fps or 30.0
            self.end_frame_edit.setText("" if at_end else str(round(seconds * fps)))
        else:
            self.end_keyframe_edit.setText("" if at_end else str(self.keyframe_index_of(seconds)))
        self.sync_active_cut_from_widgets()
        self.refresh_timeline_cuts()
        self.refresh_cut_list()

    def on_cut_mode_changed(self, is_frame):
        if self._syncing:
            return
        if self.path:
            # Cuts can't mix Frame/Keyframe modes (merge relies on every cut sharing
            # one representation) - switching modes always starts over with a single
            # cut, so confirm first if there's real work to lose.
            has_work = len(self.cuts) > 1 or any(c.crop is not None for c in self.cuts)
            if has_work:
                reply = QMessageBox.question(
                    self, "Switch Mode?",
                    "Frame and Keyframe cuts can't be mixed in the same list - switching "
                    "modes discards every cut and starts over with a single cut in the "
                    "new mode. Continue?",
                    QMessageBox.Yes | QMessageBox.No)
                if reply != QMessageBox.Yes:
                    self._syncing = True
                    self.cut_mode_frame.setChecked(not is_frame)
                    self.cut_mode_keyframe.setChecked(is_frame)
                    self._syncing = False
                    return
        self.frame_mode = is_frame
        self.scrubber.set_keyframes([] if is_frame else self.keyframe_times)
        self.frame_start_widget.setVisible(is_frame)
        self.frame_end_widget.setVisible(is_frame)
        self.keyframe_start_widget.setVisible(not is_frame)
        self.keyframe_end_widget.setVisible(not is_frame)
        if self.path:
            try:
                # Read from the mode we're leaving (self.frame_mode already reflects the
                # new mode by the time this handler fires, so get_trim_times() would
                # read the wrong, not-yet-populated field set).
                start, end = self.read_keyframe_fields_seconds() if is_frame else self.read_frame_fields_seconds()
            except ValueError:
                start, end = 0.0, self.duration
            self.cuts = [Cut(frame_mode=is_frame)]
            self.active_cut = 0
            # self.frame_mode already reflects the mode just switched to, so these
            # target the right fields; blank stays blank rather than becoming a literal
            # "0" or a concrete End number that (for Keyframe mode) could cap it to a
            # keyframe well before the file's actual end.
            self._syncing = True
            self.write_start_field(start)
            self.write_end_field(end)
            self._syncing = False
            self.select_cut(0)
        self.update_suffix_placeholder()

    def cut_start_seconds(self, cut):
        """Best-effort start time in seconds for sorting/display - reuses
        keyframe_time/fps math without touching the live widgets."""
        if cut.frame_mode:
            return cut.start_repr / (self.video_fps or 30.0)
        return self.keyframe_time(cut.start_repr)

    def ordered_cut_indices(self):
        """Indices into self.cuts in start-time (chronological) order - the order
        the cut list UI shows, used here and by both export builders so there is
        one definition of "cut order," not two (creation order vs. chronological)
        that can silently disagree."""
        return sorted(range(len(self.cuts)), key=lambda i: self.cut_start_seconds(self.cuts[i]))

    def make_cut_row_widget(self, number, start, end, has_crop):
        """A per-row widget (icon, a fixed-width left-aligned number, the
        start-end range, and - if this cut carries its own crop - a crop icon
        on the far right) so the number "column" actually lines up regardless
        of digit count (1 vs 10 vs 100) - in the normal UI font, not a
        monospace one. A plain text item can't do this: proportional fonts
        don't give equal-width digits, so padding with spaces doesn't
        reliably align."""
        widget = QWidget()
        layout = QHBoxLayout(widget)
        layout.setContentsMargins(4, 2, 4, 2)
        layout.setSpacing(6)
        icon_label = QLabel()
        icon_label.setPixmap(self.cut_row_icon.pixmap(16, 16))
        layout.addWidget(icon_label)
        number_label = QLabel(str(number))
        number_label.setMinimumWidth(QFontMetrics(number_label.font()).horizontalAdvance("999") + 4)
        layout.addWidget(number_label)
        layout.addWidget(QLabel(f"{format_time(start)}-{format_time(end)}"))
        layout.addStretch()
        if has_crop:
            crop_icon_label = QLabel()
            crop_icon_label.setPixmap(self.cut_row_crop_icon.pixmap(16, 16))
            crop_icon_label.setToolTip("This cut has its own crop")
            layout.addWidget(crop_icon_label)
        return widget

    def refresh_cut_list(self):
        was_blocked = self.cut_list.blockSignals(True)
        self.cut_list.clear()
        ordered = self.ordered_cut_indices()
        for row, cut_index in enumerate(ordered):
            cut = self.cuts[cut_index]
            start, end = self.trim_seconds_for_cut(cut)
            has_crop = self.per_cut_crop_enabled and cut.crop is not None
            item = QListWidgetItem()
            self.cut_list.addItem(item)
            self.cut_list.setItemWidget(item, self.make_cut_row_widget(row + 1, start, end, has_crop))
            item.setData(Qt.UserRole, cut_index)
            if cut_index == self.active_cut:
                self.cut_list.setCurrentRow(row)
                item.setSelected(True)
        self.cut_list.blockSignals(was_blocked)
        self.update_cut_selection_buttons()
        self.preview.set_crop_overlay_visible(len(self.selected_cut_rows()) == 1)
        self.refresh_timeline_cuts()
        self.update_combined_export_availability()

    def crops_are_uniform(self):
        """Whether every cut would export with the same crop and codec path.
        Combined-file export only supports the fast stream-copy concat demuxer,
        which requires every part to be pixel-identical - so this gates whether
        Combined is even offered, rather than falling back to a re-encoding
        concat filter for mismatched crops."""
        if len(self.cuts) <= 1:
            return True
        resolved = set()
        frame_modes = set()
        for cut in self.cuts:
            if self.per_cut_crop_enabled and cut.crop is not None:
                left, top, right, bottom = cut.crop
            else:
                left, top, right, bottom = self.shared_crop
            crop_w = (self.video_width or 0) - left - right
            crop_h = (self.video_height or 0) - top - bottom
            resolved.add((left, top, crop_w, crop_h))
            frame_modes.add(cut.frame_mode)
        return len(resolved) <= 1 and len(frame_modes) <= 1

    def update_combined_export_availability(self):
        enabled = bool(self.path) and self.crops_are_uniform()
        self.export_mode_combined.setEnabled(enabled)
        self.export_mode_combined.setToolTip(
            "" if enabled else "Combined file export requires every cut to use the same crop.")
        if not enabled and self.export_mode_combined.isChecked():
            self.export_mode_separate.setChecked(True)

    def sync_active_cut_from_widgets(self):
        """Save the Start/End/mode fields into the active cut. Deliberately does
        NOT touch cut.crop: this is called on nearly every interaction (editing
        Start/End, adding a cut, switching selection, even just clicking
        Process), including ones that never touched the crop fields at all - if
        it captured crop_edits' current text too, every one of those unrelated
        actions would silently stamp whatever crop happened to be on screen
        (often just the shared_crop fallback display) onto the active cut as if
        it were a deliberate per-cut override. Every real crop edit already
        persists through set_current_crop() directly (on_crop_field_edited,
        on_guides_changed, on_aspect_ratio_selected, clear_crop, etc.)."""
        if not self.cuts:
            return
        cut = self.cuts[self.active_cut]
        cut.frame_mode = self.frame_mode
        start_edit = self.start_frame_edit if self.frame_mode else self.start_keyframe_edit
        end_edit = self.end_frame_edit if self.frame_mode else self.end_keyframe_edit
        cut.start_repr = int(start_edit.text()) if start_edit.text() else 0
        cut.end_repr = int(end_edit.text()) if end_edit.text() else None

    def add_cut(self):
        if not self.path:
            return
        self.sync_active_cut_from_widgets()
        pos = self.current_position()
        if self.frame_mode:
            fps = self.video_fps or 30.0
            start_repr = round(pos * fps)
        else:
            start_repr = self.keyframe_index_of(pos)
        self.cuts.append(Cut(start_repr=start_repr, frame_mode=self.frame_mode))
        self.select_cut(len(self.cuts) - 1)
        self.refresh_cut_list()

    def selected_cut_rows(self):
        """Currently selected cut_list rows, sorted ascending - row numbers are
        chronological (ordered_cut_indices' order), so ascending rows == earliest
        to latest, regardless of which order they were clicked/selected in."""
        return sorted(self.cut_list.row(item) for item in self.cut_list.selectedItems())

    def update_cut_selection_buttons(self, rows=None):
        if rows is None:
            rows = self.selected_cut_rows()
        cut_indices = {self.cut_list.item(r).data(Qt.UserRole) for r in rows}
        # Delete/Keep are disabled (not just a no-op click) when the selection is
        # empty or covers every cut - there'd be nothing left outside it either
        # way, matching the old Delete Cut button's behavior of disabling once
        # only one cut remained.
        has_partial_selection = bool(rows) and len(cut_indices) < len(self.cuts)
        self.delete_selected_button.setEnabled(has_partial_selection)
        self.keep_selected_button.setEnabled(has_partial_selection)
        contiguous = len(rows) >= 2 and all(rows[i + 1] - rows[i] == 1 for i in range(len(rows) - 1))
        self.merge_selected_button.setEnabled(contiguous)

    def delete_selected_cuts(self):
        rows = self.selected_cut_rows()
        if not rows:
            return
        cut_indices = {self.cut_list.item(r).data(Qt.UserRole) for r in rows}
        if len(cut_indices) >= len(self.cuts):
            return  # would delete every cut - there must always be at least one
        self.cuts = [c for i, c in enumerate(self.cuts) if i not in cut_indices]
        # Select whatever now sits where the deleted block started - the cut right
        # after it, shifted up to fill the gap - so repeated Delete clicks walk
        # down the list instead of jumping back to row 0 every time. Falls back to
        # the new last row if the deleted block ran to the end of the list.
        new_ordered = self.ordered_cut_indices()
        next_row = min(rows[0], len(new_ordered) - 1)
        self.select_cut(new_ordered[next_row])
        self.refresh_cut_list()

    def keep_selected_cuts(self):
        rows = self.selected_cut_rows()
        if not rows:
            return
        cut_indices = {self.cut_list.item(r).data(Qt.UserRole) for r in rows}
        if len(cut_indices) >= len(self.cuts):
            return  # nothing outside the selection to discard
        self.cuts = [c for i, c in enumerate(self.cuts) if i in cut_indices]
        self.select_cut(0)
        self.refresh_cut_list()

    def merge_selected_cuts(self):
        rows = self.selected_cut_rows()
        if len(rows) < 2 or any(rows[i + 1] - rows[i] != 1 for i in range(len(rows) - 1)):
            return  # merge button is only enabled for a contiguous selection anyway
        cut_indices = [self.cut_list.item(r).data(Qt.UserRole) for r in rows]
        first_cut = self.cuts[cut_indices[0]]
        last_cut = self.cuts[cut_indices[-1]]
        # All cuts share one frame_mode (on_cut_mode_changed enforces this list-wide),
        # so first/last's start_repr/end_repr are already in the same representation -
        # no seconds round-trip needed. end_repr carries over None (through-the-end)
        # unchanged if the merge includes the chronologically last cut in the list.
        merged = Cut(start_repr=first_cut.start_repr, end_repr=last_cut.end_repr,
                     frame_mode=first_cut.frame_mode, crop=first_cut.crop)
        remove = set(cut_indices)
        new_cuts = [c for i, c in enumerate(self.cuts) if i not in remove]
        merged_index = len(new_cuts)
        new_cuts.append(merged)
        self.cuts = new_cuts
        self.select_cut(merged_index)
        self.refresh_cut_list()

    def detect_scenes(self):
        if not self.path:
            return
        has_work = len(self.cuts) > 1 or any(c.crop is not None for c in self.cuts)
        if has_work:
            reply = QMessageBox.question(
                self, "Replace Cuts?",
                "Scene detection replaces the entire cut list. Continue and discard the current cuts?",
                QMessageBox.Yes | QMessageBox.No)
            if reply != QMessageBox.Yes:
                return
        threshold = int(self.scene_threshold_edit.text() or 30) / 100.0
        self.scene_detect_output = ""
        self.detect_scenes_button.setEnabled(False)
        self.status.setText("Detecting scenes...")
        self.scene_process = QProcess(self)
        self.scene_process.setProcessChannelMode(QProcess.MergedChannels)
        self.scene_process.readyReadStandardOutput.connect(self.on_scene_detect_output)
        self.scene_process.finished.connect(self.on_scene_detect_finished)
        self.scene_process.start("ffmpeg", [
            "-i", str(self.path),
            "-vf", f"select='gt(scene,{threshold})',showinfo",
            "-f", "null", "-"])

    def on_scene_detect_output(self):
        data = bytes(self.scene_process.readAllStandardOutput()).decode(errors="replace")
        self.scene_detect_output += data

    def on_scene_detect_finished(self, exit_code, _exit_status):
        output = self.scene_detect_output
        self.scene_process = None
        # File may have been removed (remove_file already disabled the button and
        # cleared self.duration) while detection was running - nothing sensible to
        # do with a result for a file that's no longer loaded, and self.duration
        # being None would blow up the `t < self.duration` comparison below.
        if not self.path or not self.duration:
            self.detect_scenes_button.setEnabled(bool(self.path))
            return
        self.detect_scenes_button.setEnabled(True)
        if exit_code != 0:
            self.report_error("Scene detection failed", output)
            return

        times = []
        for line in output.splitlines():
            marker = "pts_time:"
            if marker in line:
                chunk = line.split(marker, 1)[1].split()[0]
                try:
                    times.append(float(chunk))
                except ValueError:
                    pass
        if not times:
            self.status.setText("No scene changes detected")
            return

        times = sorted(set(t for t in times if 0 < t < self.duration))
        boundaries = [0.0] + times + [self.duration]
        segments = list(zip(boundaries, boundaries[1:]))
        new_cuts = []
        for i, (start, end) in enumerate(segments):
            is_last = i == len(segments) - 1
            if self.frame_mode:
                fps = self.video_fps or 30.0
                end_repr = None if is_last else round(end * fps)
                new_cuts.append(Cut(start_repr=round(start * fps), end_repr=end_repr, frame_mode=True))
            else:
                end_repr = None if is_last else self.keyframe_index_of(end)
                new_cuts.append(Cut(start_repr=self.keyframe_index_of(start),
                                     end_repr=end_repr, frame_mode=False))
        self.cuts = new_cuts
        self.select_cut(0)
        self.refresh_cut_list()
        self.status.setText(f"Found {len(new_cuts)} scenes")

    def on_cut_list_selection_changed(self):
        if not self.cuts:
            return
        rows = self.selected_cut_rows()
        self.update_cut_selection_buttons(rows)
        # No selection, or more than one row, means there's no single "current
        # cut" to show a crop for.
        self.preview.set_crop_overlay_visible(len(rows) == 1)
        # A single selected row drives the Start/End/crop fields exactly like
        # before (multi-select has no one cut to edit, so the fields just keep
        # showing whatever was last active).
        if len(rows) == 1:
            self.sync_active_cut_from_widgets()
            cut_index = self.cut_list.item(rows[0]).data(Qt.UserRole)
            self.select_cut(cut_index)

    def select_cut(self, index):
        """Push cuts[index]'s data into the Start/End/mode widgets (and crop
        widgets, if per-cut crop is on) - the single sync point used by both
        UI selection and the export loop. Mirrors write_start_field/
        write_end_field's blank-means-default convention: end_repr=None
        writes a blank End field."""
        cut = self.cuts[index]
        self.active_cut = index
        self._syncing = True
        self.frame_mode = cut.frame_mode
        self.cut_mode_frame.setChecked(cut.frame_mode)
        self.cut_mode_keyframe.setChecked(not cut.frame_mode)
        self.frame_start_widget.setVisible(cut.frame_mode)
        self.frame_end_widget.setVisible(cut.frame_mode)
        self.keyframe_start_widget.setVisible(not cut.frame_mode)
        self.keyframe_end_widget.setVisible(not cut.frame_mode)
        start_edit = self.start_frame_edit if cut.frame_mode else self.start_keyframe_edit
        end_edit = self.end_frame_edit if cut.frame_mode else self.end_keyframe_edit
        start_edit.setText(str(cut.start_repr) if cut.start_repr else "")
        end_edit.setText(str(cut.end_repr) if cut.end_repr is not None else "")
        self._syncing = False
        if self.per_cut_crop_enabled:
            crop = cut.crop if cut.crop is not None else self.shared_crop
            self.show_crop(crop)
        else:
            self.update_crop_size_fields()
        self.update_suffix_placeholder()
        self.refresh_timeline_cuts()

    def show_crop(self, crop):
        """Push a resolved (left, top, right, bottom) crop into the crop text
        fields, the preview overlay, and the Size/Position fields - the single
        sync point for *displaying* a crop (as opposed to editing one), shared by
        select_cut and on_per_cut_crop_toggled. get_crop() reads
        crop_edits as the source of truth, so any path that changes which crop is
        on screen must go through here or the fields silently go stale.

        Also re-syncs the Preset dropdown to whatever this crop actually is,
        rather than leaving it showing whichever preset was last picked -
        possibly for a different cut entirely once Per-Cut Crop is on."""
        was_syncing = self._syncing
        self._syncing = True
        for edit, value in zip(self.crop_edits, crop):
            edit.setText(str(value) if value else "")
        self.aspect_combo.setCurrentIndex(self.match_aspect_preset(crop))
        self._syncing = was_syncing
        # set_locked_ratio() before set_crop_pixels(): the latter checks
        # locked_ratio to decide whether all four guides render as an engaged
        # crop line, including ones landing on exactly 0.
        self.preview.set_locked_ratio(self.current_target_ratio())
        self.preview.set_crop_pixels(*crop)
        self.update_crop_size_fields()

    def current_crop_target(self):
        if not self.per_cut_crop_enabled or not self.cuts:
            return self.shared_crop
        cut = self.cuts[self.active_cut]
        if cut.crop is None:
            cut.crop = self.shared_crop
        return cut.crop

    def set_current_crop(self, left, top, right, bottom):
        if self.per_cut_crop_enabled and self.cuts:
            self.cuts[self.active_cut].crop = (left, top, right, bottom)
        else:
            self.shared_crop = (left, top, right, bottom)
        # refresh_cut_list() also calls update_combined_export_availability() -
        # needed here too so the crop icon on this cut's row appears the moment
        # a per-cut crop is actually set, not only after reselecting/toggling.
        self.refresh_cut_list()

    def on_per_cut_crop_toggled(self, enabled):
        if self._syncing:
            return
        if not enabled and any(c.crop is not None for c in self.cuts):
            reply = QMessageBox.question(
                self, "Turn Off Per-Cut Crop?",
                "Turning off Per-Cut Crop clears every cut's individual crop override "
                "(export will use the shared crop for all of them). Continue?",
                QMessageBox.Yes | QMessageBox.No)
            if reply != QMessageBox.Yes:
                self._syncing = True
                self.per_cut_crop_check.setChecked(True)
                self._syncing = False
                return
            for cut in self.cuts:
                cut.crop = None
        if enabled and self.shared_crop != (0, 0, 0, 0):
            reply = QMessageBox.question(
                self, "Turn On Per-Cut Crop?",
                "Turning on Per-Cut Crop clears the current shared crop (cuts start "
                "crop-less until you set one individually). Continue?",
                QMessageBox.Yes | QMessageBox.No)
            if reply != QMessageBox.Yes:
                self._syncing = True
                self.per_cut_crop_check.setChecked(False)
                self._syncing = False
                return
        if enabled:
            # A cut with no override of its own falls back to shared_crop for
            # display - clear it here so cuts you haven't touched yet show as
            # crop-less, not as if they'd already inherited whatever generic
            # crop was set before switching to per-cut mode.
            self.shared_crop = (0, 0, 0, 0)
        self.per_cut_crop_enabled = enabled
        if self.path:
            # Read-only resolution, same as select_cut - toggling the checkbox only
            # changes which crop is *displayed*; it must not itself seed an override
            # onto the active cut the way an actual edit (current_crop_target) would.
            if enabled:
                cut = self.cuts[self.active_cut]
                crop = cut.crop if cut.crop is not None else self.shared_crop
            else:
                crop = self.shared_crop
            self.show_crop(crop)
        # refresh_cut_list() also calls update_combined_export_availability() -
        # needed here too since toggling changes every row's crop-icon visibility
        # at once (the icon only shows while this checkbox is on).
        self.refresh_cut_list()

    def trim_seconds_for_cut(self, cut):
        """Resolve a Cut's start/end to seconds without touching any live widget -
        the read-only counterpart to select_cut, used for list sorting (Task 2)
        and timeline segments (Task 3)."""
        if cut.frame_mode:
            fps = self.video_fps or 30.0
            start = cut.start_repr / fps
            end = cut.end_repr / fps if cut.end_repr is not None else self.duration
        else:
            start = self.keyframe_time(cut.start_repr)
            end = self.keyframe_time(cut.end_repr) if cut.end_repr is not None else self.duration
        return start, end

    def refresh_timeline_cuts(self):
        if not self.duration:
            self.scrubber.set_cuts([])
            return
        segments = []
        for i, cut in enumerate(self.cuts):
            start, end = self.trim_seconds_for_cut(cut)
            segments.append((start, end, i == self.active_cut, cut.frame_mode))
        self.scrubber.set_cuts(segments)

    def sync_selection_to_playhead(self):
        """The Cut list's selection follows the playhead: if it's inside a
        cut, that cut becomes the selected one (and its crop is what the
        overlay shows, via on_cut_list_selection_changed/refresh_cut_list); if
        it's in a gap (outside every cut), the list is deselected entirely and
        the crop overlay hides - there's no "current cut" there to show one
        for. Leaves active_cut and the Start/End fields alone when
        deselecting, so they still show whatever was last being edited."""
        if not self.cuts:
            return
        pos = self.current_position()
        match = next((i for i, c in enumerate(self.cuts)
                      if self.trim_seconds_for_cut(c)[0] <= pos <= self.trim_seconds_for_cut(c)[1]), None)
        selected_rows = self.selected_cut_rows()
        if match is None:
            if selected_rows:
                self.cut_list.clearSelection()
        else:
            already_selected = (len(selected_rows) == 1
                                 and self.cut_list.item(selected_rows[0]).data(Qt.UserRole) == match)
            if not already_selected:
                self.sync_active_cut_from_widgets()
                self.select_cut(match)
                self.refresh_cut_list()

    def on_segment_clicked(self, index):
        """Handler for Scrubber.segment_clicked, which emits a raw index into
        self.cuts (creation order, via enumerate() in refresh_timeline_cuts) -
        unlike on_cut_list_selected's row argument, this needs no translation
        through cut_list's start-time-sorted rows."""
        self.sync_active_cut_from_widgets()
        self.select_cut(index)
        self.refresh_cut_list()

    def on_segment_edited(self, index, start, end):
        if index != self.active_cut:
            self.sync_active_cut_from_widgets()
            self.select_cut(index)
        cut = self.cuts[index]
        if cut.frame_mode:
            self.write_start_field(start)
            self.write_end_field(end)
        else:
            self.start_keyframe_edit.setText(str(self.keyframe_index_of(start)))
            self.end_keyframe_edit.setText(str(self.keyframe_index_of(end)))
        self.refresh_timeline_cuts()
        self.refresh_cut_list()

    def keyframe_time(self, idx):
        if not self.keyframe_times:
            return 0.0
        idx = max(0, min(len(self.keyframe_times) - 1, idx))
        return self.keyframe_times[idx]

    def keyframe_index_of(self, t):
        """Index of the nearest keyframe at-or-before t - where a stream-copy start
        (or, for symmetry, an end picked from this same list) actually lands."""
        if not self.keyframe_times:
            return 0
        idx = bisect.bisect_right(self.keyframe_times, t) - 1
        return max(0, idx)

    # --- playback controls ---

    def toggle_playback(self):
        if self.preview.player.playbackState() == QMediaPlayer.PlayingState:
            self.preview.player.pause()
        else:
            self.preview.player.play()

    def frame_duration(self):
        return 1.0 / self.video_fps if self.video_fps else 1.0

    # QMediaPlayer.setPosition() only takes whole milliseconds, so a seek to a keyframe
    # lands up to ~1ms short of its true (sub-ms-precision) timestamp; current_position()
    # then reads back that slightly-earlier value. Without this tolerance, the next
    # prev/next press treats "slightly before keyframe X" as still short of X and finds
    # the same one again - permanently stuck, especially with closely-spaced keyframes.
    KEYFRAME_SEEK_EPS = 0.002

    def prev_keyframe_time(self, t):
        if not self.keyframe_times:
            return 0.0
        idx = bisect.bisect_left(self.keyframe_times, t - self.KEYFRAME_SEEK_EPS) - 1
        return self.keyframe_times[max(0, idx)]

    def next_keyframe_time(self, t):
        if not self.keyframe_times:
            return t
        idx = bisect.bisect_right(self.keyframe_times, t + self.KEYFRAME_SEEK_EPS)
        return self.keyframe_times[min(len(self.keyframe_times) - 1, idx)]

    def current_position(self):
        """The player's actual current position, in seconds. Reads the player directly
        rather than self.scrubber.position, which only updates when positionChanged
        arrives asynchronously - clicking a step/set button again before that signal
        lands would otherwise compute from a stale, pre-seek position."""
        return self.preview.player.position() / 1000.0

    def on_scrubber_stepped(self, direction):
        """Wheel-scroll over the timeline steps the playhead one frame (Frame mode)
        or one keyframe (Keyframe mode) at a time, matching Step Back/Forward."""
        if direction > 0:
            self.step_forward()
        else:
            self.step_back()

    def step_back(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = max(0.0, pos - self.frame_duration())
        else:
            new_pos = self.prev_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def step_forward(self):
        pos = self.current_position()
        if self.frame_mode:
            new_pos = min(self.duration or 0.0, pos + self.frame_duration())
        else:
            new_pos = self.next_keyframe_time(pos)
        self.preview.player.setPosition(int(new_pos * 1000))

    def toggle_mute(self):
        muted = not self.preview.audio_output.isMuted()
        self.preview.audio_output.setMuted(muted)
        icon = "player-volume-muted-symbolic" if muted else "player-volume-symbolic"
        self.mute_button.setIcon(QIcon.fromTheme(icon))
        self.mute_button.setToolTip("Unmute" if muted else "Mute")

    def toggle_actual_size(self):
        """Toggle the preview between scaled-to-fit and native pixel size; the window
        and sidebar are untouched, only how the video renders within the preview panel."""
        actual = not self.preview.zoom_actual
        self.preview.set_zoom_actual(actual)
        icon = "view-zoom-fit-symbolic" if actual else "zoom-in-symbolic"
        self.actual_size_button.setIcon(QIcon.fromTheme(icon))
        self.actual_size_button.setToolTip("Fit" if actual else "100%")

    def on_format_changed(self, format_name):
        is_gif = format_name == "GIF"
        is_webp = format_name == "WebP (Animated)"
        is_image = is_gif or is_webp

        def set_row_visible(row, visible):
            for widget in row:
                widget.setVisible(visible)

        self.audio_section_widget.setVisible(not is_image)
        self.image_options_widget.setVisible(is_image)
        set_row_visible(self.image_fps_row, is_image)          # shared by both
        set_row_visible(self.webp_quality_row, is_webp)
        set_row_visible(self.webp_preset_row, is_webp)
        set_row_visible(self.gif_colors_row, is_gif)
        set_row_visible(self.gif_dither_row, is_gif)
        set_row_visible(self.gif_grayscale_row, is_gif)
        set_row_visible(self.gif_optimize_row, is_gif)

    def update_scale_default(self):
        """Keeps the Scale field's unit label, scroll-step range, and
        pre-filled value in sync with the current mode - percent defaults to
        100 (a no-op scale), Longest side defaults to the source's actual
        longest dimension, both editable in place rather than hidden behind
        a generic "Original" placeholder. Called on mode change and on every
        load/remove_file, since the sensible default differs per source."""
        is_percentage = self.scale_mode_combo.currentText() == "Percentage"
        self.scale_value_edit.minimum = 1 if is_percentage else 2
        self.scale_value_edit.maximum = 1000 if is_percentage else 7680
        self.scale_value_edit.step = 5 if is_percentage else 10
        self.scale_unit_label.setText("%" if is_percentage else "px")
        if not self.path:
            self.scale_value_edit.clear()
            self.scale_value_edit.setPlaceholderText("Original")
            return
        if is_percentage:
            self.scale_value_edit.setText("100")
        else:
            self.scale_value_edit.setText(str(max(self.video_width, self.video_height)))

    def on_lock_edges_toggled(self, locked):
        self.scrubber.set_edges_locked(locked)
        icon = "changes-prevent-symbolic" if locked else "changes-allow-symbolic"
        self.lock_edges_button.setIcon(QIcon.fromTheme(icon))
        self.lock_edges_button.setToolTip("Unlock Cut Edges" if locked else "Lock Cut Edges")

    def on_snap_toggled(self, enabled):
        self.scrubber.set_snap_enabled(enabled)
        self.snap_button.setToolTip("Stop Snapping" if enabled else "Snap to Cuts")

    def on_loop_toggled(self, looping):
        self.loop_button.setToolTip("Stop Looping" if looping else "Loop Cut")
        if looping:
            rows = self.selected_cut_rows()
            if len(rows) == 1:
                cut_index = self.cut_list.item(rows[0]).data(Qt.UserRole)
                start, _end = self.trim_seconds_for_cut(self.cuts[cut_index])
                self.preview.player.setPosition(int(start * 1000))

    def enforce_loop(self, seconds):
        """When Loop is on and exactly one cut is selected, jump back to that
        cut's start once playback reaches its end, instead of running past it.
        Returns True if it seeked - the caller must skip
        sync_selection_to_playhead for this update in that case, or seeing
        the momentary past-the-end position would deselect the cut being
        looped before the seek-triggered positionChanged arrives to fix it."""
        if not self.loop_button.isChecked():
            return False
        rows = self.selected_cut_rows()
        if len(rows) != 1:
            return False
        cut_index = self.cut_list.item(rows[0]).data(Qt.UserRole)
        start, end = self.trim_seconds_for_cut(self.cuts[cut_index])
        if seconds >= end - 0.001:
            self.preview.player.setPosition(int(start * 1000))
            return True
        return False

    def set_start_from_playhead(self):
        self.write_start_field(self.current_position())

    def set_end_from_playhead(self):
        self.write_end_field(self.current_position())

    def on_playback_state_changed(self, state):
        playing = state == QMediaPlayer.PlayingState
        icon = "media-playback-pause-symbolic" if playing else "media-playback-start-symbolic"
        self.play_button.setIcon(QIcon.fromTheme(icon))
        self.play_button.setToolTip("Pause" if playing else "Play")

    def on_player_position_changed(self, position_ms):
        seconds = position_ms / 1000
        self.scrubber.set_position(seconds)
        self.time_label.setText(f"{format_time(seconds)} / {format_time(self.duration or 0)}")
        if not self.enforce_loop(seconds):
            # While looping, selection is locked to whichever cut is being
            # looped rather than following the playhead - a mid-seek position
            # can transiently land outside the cut's range (e.g. passing
            # through 0) as the player jumps back to its start, which would
            # otherwise flash the row's selection off and back on every lap.
            if not self.loop_button.isChecked():
                self.sync_selection_to_playhead()

    def on_seek_requested(self, seconds):
        self.preview.player.setPosition(int(seconds * 1000))

    def on_remove_audio_toggled(self, checked):
        if checked:
            self.audio_only.setChecked(False)

    def on_audio_only_toggled(self, checked):
        if checked:
            self.remove_audio.setChecked(False)
        for widget in self.crop_edits:
            widget.setEnabled(not checked)
        self.format_combo.setEnabled(not checked)

    def read_frame_fields_seconds(self):
        if self.duration is None:
            raise ValueError("no file loaded")
        fps = self.video_fps or 30.0
        start_frame = int(self.start_frame_edit.text() or 0)
        if start_frame < 0:
            raise ValueError("frame numbers must be >= 0")
        start = start_frame / fps
        # Blank End means "through the end of the file", matching blank Start meaning
        # "from the beginning" - not frame 0, which would make every blank-End cut empty.
        if self.end_frame_edit.text():
            end_frame = int(self.end_frame_edit.text())
            if end_frame < 0:
                raise ValueError("frame numbers must be >= 0")
            end = end_frame / fps
        else:
            end = self.duration
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("frame range leaves nothing to cut")
        return start, end

    def read_keyframe_fields_seconds(self):
        if not self.keyframe_times:
            raise ValueError("no keyframe data")
        start_idx = int(self.start_keyframe_edit.text()) if self.start_keyframe_edit.text() else 0
        if start_idx < 0:
            raise ValueError("keyframe numbers must be >= 0")
        start = self.keyframe_time(start_idx)
        # Blank End means "through the end of the file". Unlike Start, the end of a
        # stream-copy cut doesn't need to land on a keyframe, so it isn't capped to the
        # last keyframe's time - which can sit well before the file's actual end (e.g. a
        # clip with only one keyframe would otherwise default End to time 0).
        if self.end_keyframe_edit.text():
            end_idx = int(self.end_keyframe_edit.text())
            if end_idx < 0:
                raise ValueError("keyframe numbers must be >= 0")
            end = self.keyframe_time(end_idx)
        else:
            end = self.duration
        if not (0 <= start < end <= self.duration + 0.01):
            raise ValueError("keyframe range leaves nothing to cut")
        return start, end

    def get_trim_times(self):
        if self.frame_mode:
            return self.read_frame_fields_seconds()
        return self.read_keyframe_fields_seconds()

    def get_crop(self):
        left, top, right, bottom = (int(edit.text() or 0) for edit in self.crop_edits)
        for name, v in (("left", left), ("top", top), ("right", right), ("bottom", bottom)):
            if v < 0:
                raise ValueError(f"crop {name} must be >= 0")
        crop_w = self.video_width - left - right
        crop_h = self.video_height - top - bottom
        has_crop = bool(left or top or right or bottom)
        if has_crop and (crop_w <= 0 or crop_h <= 0):
            raise ValueError("crop margins exceed frame size")
        return left, top, crop_w, crop_h, has_crop

    def build_scale_filter(self, width, height):
        """Return a scale=... filter string for the given (post-crop) output
        dimensions, or None if the Scale field is blank (original size).
        Raises ValueError on bad input."""
        text = self.scale_value_edit.text().strip()
        if not text:
            return None
        try:
            value = float(text)
        except ValueError:
            raise ValueError("scale value must be a number")
        if value <= 0:
            raise ValueError("scale value must be > 0")
        if self.scale_mode_combo.currentText() == "Percentage":
            factor = value / 100.0
            # trunc(.../2)*2 keeps both dimensions even, which most codecs
            # (yuv420p chroma subsampling) require.
            return f"scale=trunc(iw*{factor}/2)*2:trunc(ih*{factor}/2)*2"
        target = int(round(value))
        if target % 2:
            target += 1
        return f"scale={target}:-2" if width >= height else f"scale=-2:{target}"

    def build_fps_filter(self):
        """GIF/WebP-only: return a fps=... filter, or None if left blank
        (original frame rate). The main lever for shrinking an animated
        export beyond what quality/compression alone can do."""
        text = self.image_fps_edit.text().strip()
        if not text:
            return None
        try:
            value = float(text)
        except ValueError:
            raise ValueError("frame rate must be a number")
        if value <= 0:
            raise ValueError("frame rate must be > 0")
        return f"fps={value}"

    def build_eq_filter(self):
        """GIF-only: return an eq=saturation=0 filter when Black and white
        is checked, else None."""
        return "eq=saturation=0" if self.gif_grayscale_check.isChecked() else None

    def gif_max_colors(self):
        text = self.gif_colors_edit.text().strip() or "256"
        try:
            value = int(text)
        except ValueError:
            raise ValueError("max colors must be a whole number")
        if not 2 <= value <= 256:
            raise ValueError("max colors must be between 2 and 256")
        return value

    def webp_quality(self):
        text = self.webp_quality_edit.text().strip() or "80"
        try:
            value = int(text)
        except ValueError:
            raise ValueError("quality must be a whole number")
        if not 0 <= value <= 100:
            raise ValueError("quality must be between 0 and 100")
        return value

    def compute_default_suffix(self):
        """Best-effort suffix reflecting current options, for the placeholder text."""
        if self.audio_only.isChecked():
            return "audio_only"
        try:
            start, end = self.get_trim_times()
            trimmed = start > 0 or end < (self.duration or 0)
        except ValueError:
            trimmed = False
        try:
            _, _, _, _, has_crop = self.get_crop() if self.path else (0, 0, 0, 0, False)
        except ValueError:
            has_crop = False

        parts = []
        if has_crop:
            parts.append("cropped")
        if self.remove_audio.isChecked():
            parts.append("no_audio")
        if trimmed or not parts:
            parts.append("cut")
        if self.frame_mode:
            parts.append("exact")
        return "_".join(parts)

    def update_suffix_placeholder(self):
        self.suffix_edit.setPlaceholderText(self.compute_default_suffix())

    def export_ext(self):
        if self.audio_only.isChecked():
            return ".m4a"
        format_name = self.format_combo.currentText()
        if format_name in IMAGE_FORMAT_EXTS:
            return IMAGE_FORMAT_EXTS[format_name]
        preset = FORMAT_PRESETS[format_name]
        return preset[0] if preset else self.path.suffix

    def build_ffmpeg_args(self, out_path):
        """Return (cmd, target_duration) for the currently-active cut's trim/crop/
        audio/format settings, writing to the given out_path. Raises ValueError on
        bad input. Path-agnostic, reused by every export path (single, per-cut,
        combined)."""
        start, end = self.get_trim_times()
        target_duration = end - start
        cmd = ["ffmpeg", "-y", "-progress", "pipe:1", "-i", str(self.path), "-ss", str(start), "-to", str(end)]

        if self.audio_only.isChecked():
            cmd += ["-vn", "-c:a", "copy", str(out_path)]
            return cmd, target_duration

        format_name = self.format_combo.currentText()
        left, top, crop_w, crop_h, has_crop = self.get_crop()
        crop_filter = f"crop={crop_w}:{crop_h}:{left}:{top}" if has_crop else None
        effective_w = crop_w if has_crop else self.video_width
        effective_h = crop_h if has_crop else self.video_height
        scale_filter = self.build_scale_filter(effective_w, effective_h)
        vf_parts = [f for f in (crop_filter, scale_filter) if f]

        if format_name == "GIF":
            # A generated palette (rather than the plain gif codec's fixed
            # web-safe one) is what actually gives GIF output good color -
            # fps/crop/scale, if any, have to happen upstream of that same
            # filter chain, not as a separate -vf.
            eq_filter = self.build_eq_filter()
            fps_filter = self.build_fps_filter()
            parts = ([eq_filter] if eq_filter else []) + ([fps_filter] if fps_filter else []) + vf_parts
            prefix = ",".join(parts) + "," if parts else ""
            max_colors = self.gif_max_colors()
            dither = GIF_DITHER_MODES[self.gif_dither_combo.currentText()]
            chain = (f"{prefix}split[s0][s1];[s0]palettegen=stats_mode=diff:"
                     f"max_colors={max_colors}[p];[s1][p]paletteuse=dither={dither}")
            cmd += ["-vf", chain, "-an", str(out_path)]
            return cmd, target_duration

        if format_name == "WebP (Animated)":
            fps_filter = self.build_fps_filter()
            parts = ([fps_filter] if fps_filter else []) + vf_parts
            if parts:
                cmd += ["-vf", ",".join(parts)]
            quality = self.webp_quality()
            preset = WEBP_PRESETS[self.webp_preset_combo.currentText()]
            cmd += ["-c:v", "libwebp_anim", "-lossless", "0", "-quality", str(quality),
                    "-preset", str(preset), "-loop", "0", "-an", str(out_path)]
            return cmd, target_duration

        preset = FORMAT_PRESETS[format_name]
        if vf_parts:
            # Scaling (like cropping) can't stream-copy - it always needs a
            # real re-encode, even in Original/keyframe mode.
            cmd += ["-vf", ",".join(vf_parts)]
            cmd += preset[1] if preset else ["-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        elif preset:
            cmd += preset[1]
        elif self.frame_mode:
            cmd += ["-c:v", "libx264", "-crf", "17", "-preset", "veryfast"]
        else:
            cmd += ["-c:v", "copy"]

        if self.remove_audio.isChecked():
            cmd += ["-an"]
        elif preset:
            cmd += preset[2]
        else:
            cmd += ["-c:a", "copy"]
        cmd.append(str(out_path))
        return cmd, target_duration

    def advance_spinner(self):
        frame = self.spinner_frames[self.spinner_index]
        self.spinner_index = (self.spinner_index + 1) % len(self.spinner_frames)
        self.status.setText(f"{frame} {self.spinner_label}... {self.progress_percent}%")

    def on_process_output(self):
        if self.progress_target_duration <= 0:
            self.process.readAllStandardOutput()
            return
        data = bytes(self.process.readAllStandardOutput()).decode(errors="replace")
        self.progress_buffer += data
        *complete_lines, self.progress_buffer = self.progress_buffer.split("\n")
        for line in complete_lines:
            seconds = parse_out_time_seconds(line.strip())
            if seconds is not None:
                pct = max(0, min(100, int(seconds / self.progress_target_duration * 100)))
                self.progress_percent = pct

    def do_process(self):
        if self.export_mode_combined.isChecked() and len(self.cuts) > 1:
            self.do_process_combined()
            return
        self.export_is_combined = False
        try:
            self.sync_active_cut_from_widgets()
            saved_active = self.active_cut
            append_text = self.suffix_edit.text().strip() or self.compute_default_suffix()
            queue = []
            for row, cut_index in enumerate(self.ordered_cut_indices()):
                self.select_cut(cut_index)
                ext = self.export_ext()
                suffix = f"{append_text}_{row + 1}" if len(self.cuts) > 1 else append_text
                out_path = next_available(self.path.with_name(f"{self.path.stem}_{suffix}{ext}"))
                cmd, target_duration = self.build_ffmpeg_args(out_path)
                queue.append((cmd, out_path, target_duration))
            self.select_cut(saved_active)
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            self.error_details_button.setVisible(False)
            return

        self.export_queue = queue
        self.export_total = len(queue)
        self.export_current = 0
        self.export_gif_optimize = (self.format_combo.currentText() == "GIF"
                                     and self.gif_optimize_check.isChecked()
                                     and GIFSICLE_PATH is not None)
        self.error_details_button.setVisible(False)
        self.process_button.setEnabled(False)
        self.run_next_export()

    def do_process_combined(self):
        if not self.crops_are_uniform():
            # Belt-and-suspenders: the Combined radio is disabled whenever crops
            # differ (update_combined_export_availability), so this shouldn't be
            # reachable, but never silently build a nonsensical combined file.
            self.status.setText("Combined export requires every cut to use the same crop")
            self.error_details_button.setVisible(False)
            return
        try:
            self.sync_active_cut_from_widgets()
            saved_active = self.active_cut
            tmp_dir = Path(tempfile.mkdtemp(prefix="clipcut_"))
            queue = []
            for row, cut_index in enumerate(self.ordered_cut_indices()):
                self.select_cut(cut_index)
                ext = self.export_ext()
                tmp_path = tmp_dir / f"part_{row + 1}{ext}"
                cmd, target_duration = self.build_ffmpeg_args(tmp_path)
                queue.append((cmd, tmp_path, target_duration))
            self.select_cut(saved_active)
        except ValueError as e:
            self.status.setText(f"Invalid input: {e}")
            self.error_details_button.setVisible(False)
            return

        self.combined_tmp_dir = tmp_dir
        self.export_queue = queue
        self.export_total = len(queue)
        self.export_current = 0
        self.export_is_combined = True
        # The per-cut parts are temp files discarded after concat - never
        # worth optimizing. Only the final joined output (set in run_concat)
        # is a real GIF export worth running gifsicle on.
        self.export_gif_optimize = False
        self.error_details_button.setVisible(False)
        self.process_button.setEnabled(False)
        self.run_next_export()

    def run_concat(self):
        parts = sorted(self.combined_tmp_dir.glob("part_*"), key=lambda p: int(p.stem.split("_")[1]))
        append_text = self.suffix_edit.text().strip() or self.compute_default_suffix()
        ext = self.export_ext()
        out_path = next_available(self.path.with_name(f"{self.path.stem}_{append_text}{ext}"))

        list_path = self.combined_tmp_dir / "list.txt"
        list_path.write_text("".join(f"file '{p}'\n" for p in parts))
        cmd = ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(list_path), "-c", "copy", str(out_path)]

        self.pending_out_path = out_path
        self.export_is_combined = False  # concat's own finish should behave like a normal single completion
        self.export_gif_optimize = (self.format_combo.currentText() == "GIF"
                                     and self.gif_optimize_check.isChecked()
                                     and GIFSICLE_PATH is not None)
        self.progress_target_duration = 0
        self.progress_percent = 0
        self.spinner_index = 0
        self.spinner_label = "Joining"
        self.advance_spinner()
        self.spinner_timer.start()  # the preceding per-part on_process_finished stopped it
        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_concat_finished)
        self.process.errorOccurred.connect(self.on_process_error)
        self.process.start(cmd[0], cmd[1:])

    def on_concat_finished(self, exit_code, exit_status):
        self.cleanup_combined_tmp_dir()
        self.on_process_finished(exit_code, exit_status)

    def run_next_export(self):
        if not self.export_queue:
            if getattr(self, "export_is_combined", False):
                self.run_concat()
                return
            self.spinner_timer.stop()
            self.process_button.setEnabled(True)
            self.status.setText("Saved successfully")
            return
        cmd, out_path, target_duration = self.export_queue.pop(0)
        self.pending_out_path = out_path
        self.progress_target_duration = target_duration
        self.progress_buffer = ""
        self.progress_percent = 0
        self.spinner_index = 0
        self.export_current += 1
        self.spinner_label = (f"Exporting {self.export_current} of {self.export_total}"
                               if self.export_total > 1 else "Working")
        self.advance_spinner()
        self.spinner_timer.start()

        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_process_finished)
        self.process.errorOccurred.connect(self.on_process_error)
        self.process.start(cmd[0], cmd[1:])

    def report_error(self, summary, details):
        self.status.setText(summary)
        self.error_details = details
        self.error_details_button.setVisible(bool(details))

    def show_error_details(self):
        dialog = QDialog(self)
        dialog.setWindowTitle("Error Details")
        dialog.resize(600, 400)
        layout = QVBoxLayout(dialog)
        text = QPlainTextEdit(self.error_details)
        text.setReadOnly(True)
        layout.addWidget(text)
        close_button = QPushButton("Close")
        close_button.clicked.connect(dialog.close)
        layout.addWidget(close_button)
        dialog.exec()

    def cleanup_combined_tmp_dir(self):
        """Remove the combined-export scratch dir, if one is in flight, so a
        failed combined export (per-cut part failure, or ffmpeg failing to
        launch) doesn't leave a clipcut_* temp directory full of video parts
        behind permanently. Safe to call unconditionally - cleared after use so
        a later unrelated export doesn't try to clean it again."""
        tmp_dir = getattr(self, "combined_tmp_dir", None)
        if tmp_dir is not None:
            shutil.rmtree(tmp_dir, ignore_errors=True)
            self.combined_tmp_dir = None

    def on_process_error(self, _error):
        self.spinner_timer.stop()
        self.process_button.setEnabled(True)
        self.report_error("Failed to launch ffmpeg", self.process.errorString())
        self.process = None
        self.export_queue = []
        self.cleanup_combined_tmp_dir()

    def on_process_finished(self, exit_code, _exit_status):
        self.spinner_timer.stop()
        stderr = bytes(self.process.readAllStandardError()).decode(errors="replace")
        self.process = None

        if exit_code != 0:
            self.process_button.setEnabled(True)
            self.report_error("ffmpeg failed", stderr)
            self.export_queue = []
            self.cleanup_combined_tmp_dir()
            return

        out_path = self.pending_out_path
        src_stat = self.path.stat()
        os.utime(out_path, (src_stat.st_atime, src_stat.st_mtime))
        self.error_details_button.setVisible(False)
        if getattr(self, "export_gif_optimize", False):
            self.run_gifsicle(out_path)
        else:
            self.run_next_export()

    def run_gifsicle(self, out_path):
        """gifsicle's -b rewrites the file in place (it reads the whole
        input before writing output, so this is safe) - -O3 is its full
        optimization level, --lossy trades a little fidelity for a lot more
        compression than ffmpeg's palette approach alone can reach."""
        self.pending_out_path = out_path
        self.progress_target_duration = 0  # gifsicle has no -progress-style output to parse
        self.progress_percent = 0
        self.spinner_index = 0
        self.spinner_label = "Optimizing"
        self.advance_spinner()
        self.spinner_timer.start()
        self.process = QProcess(self)
        self.process.readyReadStandardOutput.connect(self.on_process_output)
        self.process.finished.connect(self.on_gifsicle_finished)
        self.process.errorOccurred.connect(self.on_gifsicle_error)
        self.process.start(GIFSICLE_PATH, ["-b", "-O3", "--lossy=80", str(out_path)])

    def on_gifsicle_finished(self, _exit_code, _exit_status):
        # Best-effort: the ffmpeg-produced GIF is already valid and saved
        # either way, so a gifsicle failure just means this one export
        # missed the extra optimization pass, not that the export failed.
        self.spinner_timer.stop()
        self.process = None
        self.run_next_export()

    def on_gifsicle_error(self, _error):
        self.spinner_timer.stop()
        self.process = None
        self.run_next_export()


def main():
    app = QApplication(sys.argv)
    initial = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else None
    win = MainWindow(initial)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
