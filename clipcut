    def eventFilter(self, obj, event):
        if obj is self.preview.viewport():
            if event.type() in (QEvent.DragEnter, QEvent.DragMove):
                if event.mimeData().hasUrls():
                    event.acceptProposedAction()
                    return True
            elif event.type() == QEvent.Drop:
                urls = event.mimeData().urls()
                if urls:
                    self.load_file(Path(urls[0].toLocalFile()))
                return True
        return super().eventFilter(obj, event)

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dragMoveEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event):
        urls = event.mimeData().urls()
        if urls:
            self.load_file(Path(urls[0].toLocalFile()))

    def browse_for_file(self):
        filename, _filter = QFileDialog.getOpenFileName(self, "Open video", str(Path.home()), "Videos (*.mp4 *.mkv *.mov *.webm *.avi);;All files (*)")
        if filename:
            self.load_file(Path(filename))

    def load_file(self, path):
        try:
            w, h, duration, fps = probe(path)
        except Exception as e:
            self.status.setText(f"Failed to read file: {e}")
            return
        self.path = path
        self.video_width, self.video_height = w, h
        self.duration = duration
        self.video_fps = fps
        self.keyframe_times = get_keyframe_times(path)
        self.filename_label.setText(f"{path.name}  ({w}x{h}, {duration:.1f}s)")
        self.browse_button.setText("Replace File...")
        for field in self.time_edits:
            field.clear()
        for field in self.frame_edits:
            field.clear()
        for field in self.crop_edits:
            field.clear()
        self.process_button.setEnabled(True)
        self.play_button.setEnabled(True)
        self.step_back_button.setEnabled(True)
        self.step_forward_button.setEnabled(True)
        self.mute_button.setEnabled(True)
        self.remove_file_button.setEnabled(True)
        self.set_start_button.setEnabled(True)
        self.set_end_button.setEnabled(True)
        self.status.setText("")
        self.update_suffix_placeholder()

        self.preview.load(path, w, h)
        self.scrubber.set_duration(duration)
        self.time_label.setText(f"0:00 / {format_time(duration)}")

    def remove_file(self):
        self.path = None
        self.video_width = None
        self.video_height = None
        self.duration = None
        self.video_fps = None
        self.keyframe_times = []
        self.filename_label.setText("Drag and drop or choose a file")
        self.browse_button.setText("Browse...")
        for field in self.time_edits:
            field.clear()
        for field in self.frame_edits:
            field.clear()
        for field in self.crop_edits:
            field.clear()
        self.process_button.setEnabled(False)
        self.play_button.setEnabled(False)
        self.step_back_button.setEnabled(False)
        self.step_forward_button.setEnabled(False)
        self.mute_button.setEnabled(False)
        self.remove_file_button.setEnabled(False)
        self.set_start_button.setEnabled(False)
        self.set_end_button.setEnabled(False)
        self.status.setText("")
        self.update_suffix_placeholder()

        self.preview.unload()
        self.scrubber.set_duration(0)
