class DropOverlay(QLabel):
    """Full-window phantom drop target, upload-site style: hidden until a drag enters
    the window (shown by the parent's dragEnterEvent), then covers everything so a
    drop lands correctly no matter which widget is underneath the cursor."""

    def __init__(self, on_drop, parent):
        super().__init__("Drop video file to load", parent)
        self.on_drop = on_drop
        self.setAlignment(Qt.AlignCenter)
        self.setStyleSheet(
            "QLabel { background-color: rgba(20, 20, 20, 210); color: white; "
            "font-size: 20px; border: 3px dashed #999999; }"
        )
        self.setAcceptDrops(True)
        self.hide()

    def dragEnterEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dragMoveEvent(self, event):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dragLeaveEvent(self, _event):
        self.hide()

    def dropEvent(self, event):
        urls = event.mimeData().urls()
        self.hide()
        if urls:
            self.on_drop(Path(urls[0].toLocalFile()))


class GuideItem(QGraphicsRectItem):
    """A draggable crop guide line. Calls back with its new scene-coordinate
    position (y for horizontal guides, x for vertical) while dragged."""

    ACTIVE_COLOR = QColor(255, 0, 255)
    INACTIVE_COLOR = QColor(255, 255, 255, 60)

    def __init__(self, orientation, on_drag):
        super().__init__()
        self.orientation = orientation  # 'h' (drags vertically) or 'v' (drags horizontally)
        self.on_drag = on_drag
        self.setCursor(Qt.SizeVerCursor if orientation == "h" else Qt.SizeHorCursor)
        self.setPen(Qt.NoPen)
        self.setBrush(Qt.NoBrush)
        self.setZValue(10)
        self.setAcceptedMouseButtons(Qt.LeftButton)
        self._dragging = False
        self._active = False

    def set_active(self, active):
        if active != self._active:
            self._active = active
            self.update()

    def paint(self, painter, _option, _widget=None):
        painter.fillRect(self.rect(), self.ACTIVE_COLOR if self._active else self.INACTIVE_COLOR)

    def mousePressEvent(self, event):
        self._dragging = True
        event.accept()

    def mouseMoveEvent(self, event):
        if not self._dragging:
            return
        pos = event.scenePos()
        self.on_drag(pos.y() if self.orientation == "h" else pos.x())

    def mouseReleaseEvent(self, _event):
        self._dragging = False


class VideoPreview(QGraphicsView):
    """Video surface with playback, drop-to-load, and draggable crop guides overlaid on the frame."""

    guides_changed = Signal(int, int, int, int)  # left, top, right, bottom (real video pixels)

    THICKNESS = 1
    PADDING = 24

    def __init__(self, on_drop, parent=None):
        super().__init__(parent)
        self.on_drop = on_drop
        # Deliberately does NOT accept drops itself: Qt only bubbles unclaimed drag
        # events up to an accepting ancestor, so this widget must stay out of the way
        # for the window-level phantom drop overlay to receive them.
        self.setMinimumSize(320, 240)
        self.setStyleSheet("background-color: #000000; border: none;")
        self.setFrameShape(QFrame.NoFrame)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOff)

        self.gscene = QGraphicsScene(self)
        self.setScene(self.gscene)

        self.video_width = None
        self.video_height = None
        self.crop = (0, 0, 0, 0)  # left, top, right, bottom, in real video pixels

        self.video_item = QGraphicsVideoItem()
        self.gscene.addItem(self.video_item)

        self.player = QMediaPlayer(self)
        self.player.setLoops(QMediaPlayer.Infinite)
        self.audio_output = QAudioOutput(self)
        self.player.setAudioOutput(self.audio_output)
        self.player.setVideoOutput(self.video_item)
        self.player.errorOccurred.connect(self.on_player_error)

        self.fallback_item = QGraphicsPixmapItem()
        self.gscene.addItem(self.fallback_item)
        self.fallback_item.hide()

        self.hint_item = self.gscene.addSimpleText("Drop video here")
        self.hint_item.setBrush(QColor("#999999"))

        self.guide_top = GuideItem("h", lambda y: self._guide_dragged("top", y))
        self.guide_bottom = GuideItem("h", lambda y: self._guide_dragged("bottom", y))
        self.guide_left = GuideItem("v", lambda x: self._guide_dragged("left", x))
        self.guide_right = GuideItem("v", lambda x: self._guide_dragged("right", x))
        for g in (self.guide_top, self.guide_bottom, self.guide_left, self.guide_right):
            self.gscene.addItem(g)
            g.hide()

        self.shade_top = QGraphicsRectItem()
        self.shade_bottom = QGraphicsRectItem()
        self.shade_left = QGraphicsRectItem()
        self.shade_right = QGraphicsRectItem()
        for s in (self.shade_top, self.shade_bottom, self.shade_left, self.shade_right):
            s.setBrush(QColor(0, 0, 0, 140))
            s.setPen(Qt.NoPen)
            s.setZValue(5)
            self.gscene.addItem(s)
            s.hide()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        rect = self.viewport().rect()
        self.gscene.setSceneRect(0, 0, rect.width(), rect.height())
        text_rect = self.hint_item.boundingRect()
        self.hint_item.setPos((rect.width() - text_rect.width()) / 2,
                               (rect.height() - text_rect.height()) / 2)
        self.refresh_overlay()

    def load(self, path, video_width, video_height):
        self.video_width = video_width
        self.video_height = video_height
        self.crop = (0, 0, 0, 0)
        self.hint_item.hide()
        self.fallback_item.hide()
        self.video_item.show()
        self.player.setSource(QUrl.fromLocalFile(str(path)))
        self.player.play()
        for g in (self.guide_top, self.guide_bottom, self.guide_left, self.guide_right):
            g.show()
        for s in (self.shade_top, self.shade_bottom, self.shade_left, self.shade_right):
            s.show()
        self.refresh_overlay()

    def on_player_error(self, _error, _error_string):
        if not self.video_width:
            return
        png_bytes = grab_thumbnail(self.player.source().toLocalFile())
        if not png_bytes:
            return
        pixmap = QPixmap()
        pixmap.loadFromData(png_bytes, "PNG")
        self.fallback_item.setPixmap(pixmap)
        self.video_item.hide()
        self.fallback_item.show()
        self.refresh_overlay()

    def content_rect(self):
        """Where the video frame is actually drawn within the view (letterbox/pillarbox-aware),
        inset by PADDING so crop=0 guides land clear of the video/window edge and stay grabbable."""
        rect = self.viewport().rect()
        if not self.video_width or not self.video_height:
            return QRect(0, 0, rect.width(), rect.height())
        w = max(1, rect.width() - 2 * self.PADDING)
        h = max(1, rect.height() - 2 * self.PADDING)
        video_aspect = self.video_width / self.video_height
        widget_aspect = w / h
        if widget_aspect > video_aspect:
            disp_h = h
            disp_w = int(h * video_aspect)
        else:
            disp_w = w
            disp_h = int(w / video_aspect)
        x = (rect.width() - disp_w) // 2
        y = (rect.height() - disp_h) // 2
        return QRect(x, y, disp_w, disp_h)

    def set_crop_pixels(self, left, top, right, bottom):
        self.crop = (left, top, right, bottom)
        self.refresh_overlay()

    def refresh_overlay(self):
        rect = self.content_rect()
        full = self.viewport().rect()
        self.video_item.setPos(rect.x(), rect.y())
        self.video_item.setSize(rect.size().toSizeF())
        self.fallback_item.setPos(rect.x(), rect.y())
        if not self.fallback_item.pixmap().isNull():
            scale = rect.width() / max(1, self.fallback_item.pixmap().width())
            self.fallback_item.setScale(scale)

        if not self.video_width or not self.video_height:
            return
        left, top, right, bottom = self.crop
        sx = rect.width() / self.video_width
        sy = rect.height() / self.video_height
        t = self.THICKNESS

        gx_left = rect.left() + int(left * sx)
        gx_right = rect.right() - int(right * sx)
        gy_top = rect.top() + int(top * sy)
        gy_bottom = rect.bottom() - int(bottom * sy)

        self.guide_left.setRect(gx_left - t / 2, 0, t, full.height())
        self.guide_right.setRect(gx_right - t / 2, 0, t, full.height())
        self.guide_top.setRect(0, gy_top - t / 2, full.width(), t)
        self.guide_bottom.setRect(0, gy_bottom - t / 2, full.width(), t)
        self.guide_left.set_active(left > 0)
        self.guide_right.set_active(right > 0)
        self.guide_top.set_active(top > 0)
        self.guide_bottom.set_active(bottom > 0)

        self.shade_left.setRect(0, 0, max(0, gx_left), full.height())
        self.shade_right.setRect(gx_right, 0, max(0, full.width() - gx_right), full.height())
        self.shade_top.setRect(0, 0, full.width(), max(0, gy_top))
        self.shade_bottom.setRect(0, gy_bottom, full.width(), max(0, full.height() - gy_bottom))

    def _guide_dragged(self, which, pos):
        rect = self.content_rect()
        sx = rect.width() / self.video_width
        sy = rect.height() / self.video_height
        left, top, right, bottom = self.crop
        if which == "left":
            left = max(0, min(self.video_width - 1, int((pos - rect.left()) / sx)))
        elif which == "right":
            right = max(0, min(self.video_width - 1, int((rect.right() - pos) / sx)))
        elif which == "top":
            top = max(0, min(self.video_height - 1, int((pos - rect.top()) / sy)))
        elif which == "bottom":
            bottom = max(0, min(self.video_height - 1, int((rect.bottom() - pos) / sy)))
        self.crop = (left, top, right, bottom)
        self.refresh_overlay()
        self.guides_changed.emit(left, top, right, bottom)


class Scrubber(QWidget):
    """Seek bar with a playhead plus draggable start/end trim handles."""

    seek_requested = Signal(float)
    trim_changed = Signal(float, float)  # absolute start seconds, absolute end seconds

    HANDLE_GRAB = 6

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumHeight(28)
        self.duration = 0.0
        self.position = 0.0
        self.trim_start = 0.0
        self.trim_end = 0.0
        self._dragging = None

    def set_duration(self, duration):
        self.duration = duration
        self.trim_start = 0.0
        self.trim_end = duration
        self.update()

    def set_position(self, seconds):
        self.position = seconds
        self.update()

    def set_trim(self, start, end):
        self.trim_start = start
        self.trim_end = end
        self.update()

    def x_for_time(self, t):
        if self.duration <= 0:
            return 0
        return int(t / self.duration * self.width())

    def time_for_x(self, x):
        if self.width() <= 0 or self.duration <= 0:
            return 0.0
        return max(0.0, min(self.duration, x / self.width() * self.duration))

    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), QColor("#2a2a2a"))
        if self.duration > 0:
            x1 = self.x_for_time(self.trim_start)
            x2 = self.x_for_time(self.trim_end)
            painter.fillRect(x1, 0, max(1, x2 - x1), self.height(), QColor("#3a5f8a"))
            px = self.x_for_time(self.position)
            painter.fillRect(px - 1, 0, 2, self.height(), QColor("#ffffff"))
            painter.fillRect(x1 - 2, 0, 4, self.height(), QColor("#7fc7ff"))
            painter.fillRect(x2 - 2, 0, 4, self.height(), QColor("#7fc7ff"))
        painter.end()

    def _handle_at(self, x):
        if self.duration <= 0:
            return None
        if abs(x - self.x_for_time(self.trim_start)) <= self.HANDLE_GRAB:
            return "start"
        if abs(x - self.x_for_time(self.trim_end)) <= self.HANDLE_GRAB:
            return "end"
        return "playhead"

    def mousePressEvent(self, event):
        x = event.position().toPoint().x()
        self._dragging = self._handle_at(x)
        self._drag_to(x)

    def mouseMoveEvent(self, event):
        if self._dragging:
            self._drag_to(event.position().toPoint().x())

    def mouseReleaseEvent(self, _event):
        self._dragging = None

    def _drag_to(self, x):
        t = self.time_for_x(x)
        if self._dragging == "start":
            self.trim_start = max(0.0, min(t, self.trim_end - 0.1))
            self.trim_changed.emit(self.trim_start, self.trim_end)
        elif self._dragging == "end":
            self.trim_end = min(self.duration, max(t, self.trim_start + 0.1))
            self.trim_changed.emit(self.trim_start, self.trim_end)
        elif self._dragging == "playhead":
            self.position = t
            self.seek_requested.emit(t)
        self.update()


